{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*\\$?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\d*\\s*(?:[Ff][Oo][Rr]|[Ww][Hh][Ii][Ll][Ee])\\b(?!.*\\b(?:[Nn][Ee][Xx][Tt]|[Ww][Ee][Nn][Dd])\\b).*$",
    "decreaseIndentPattern": "^\\s*\\d*\\s*(?:[Nn][Ee][Xx][Tt]|[Ww][Ee][Nn][Dd])\\b"
  }
}
