#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "bdb.h"
#include "os.h"
#include "token.h"

extern bmem_t *bmem;

static bool bdb_is_urn(char *str) {
    if (!str)
        return false;

    str = string_cstr(str);
    while (*str) {
        if (*str++ == ':')
            return true;
    }
    return false;
}

// Split a URN into parts
static split_t *bdb_urn_split(const char *urn) {
    static const char *g_urn_protos[] = {"tcp", "ws", "wss", "ftp", NULL};

    static split_t split;
    for (int i = 0; i < URN_PARTS_MAX; i++) {
        split.parts[i] = "";
    }
    split.n = 0;
    split.proto = URN_PROTO_NONE;

    const char *src = urn;
    char *dst = split.urn;
    bool new_part = true;

    while (new_part && split.n < URN_PARTS_MAX - 1) {
        split.parts[split.n++] = dst;
        while (*src && *src != ':')
            *dst++ = *src++;
        new_part = *src++ == ':';
        *dst++ = '\0';
    }

    uint8_t n = 0;
    for (const char **proto = g_urn_protos; *proto; proto++) {
        n++;
        if (strcmp(*proto, split.parts[0]) == 0) {
            split.proto = n;
            break;
        }
    }

    split.port = strtoul(split.parts[URN_PART_PORT], 0, 10);

    return &split;
}

// Return the size of an entry
static int bdb_entry_size(entry_t *entry) {
    return bmem_align4(sizeof(entry_t) + entry->name_ofs +
                       strlen((char *)(entry->bytes + entry->name_ofs)) + 1);
}

// Return the first entry
static entry_t *bdb_entry_first() {
    if (bmem->db_start == bmem->db_end)
        return 0;
    return (entry_t *)bmem->db_start;
}

// Return the next entry
static entry_t *bdb_entry_next(entry_t *entry) {
    int size = bdb_entry_size(entry);
    entry_t *next = (entry_t *)((uint8_t *)entry + size);
    if ((uint8_t *)next >= bmem->db_end)
        return 0;
    return next;
}

// Allocate an entry in the database, set memory to 0 and return the entry
static entry_t *bdb_entry_alloc(uint16_t size) {
    int psize = bmem_align4(size);
    if (BASTOS_DB_SIZE - (bmem->db_end - bmem->db_start) < psize)
        return 0;

    bmem->db_start -= psize;
    memset(bmem->db_start, 0, psize);
    return (entry_t *)bmem->db_start;
}

// Create a new entry and copy the name
static entry_t *bdb_entry_new(uint8_t set, const char *key, uint8_t *value,
                              uint16_t size) {
    int key_size = strlen(key) + 1;
    int data_size = size + 2 + 1;

    // Allocate entry
    entry_t *entry = bdb_entry_alloc(sizeof(entry_t) + data_size + key_size);
    if (!entry)
        return 0;

    // Init entry
    entry->token = set;
    entry->name_ofs = data_size;
    entry->dim_count = 0;

    // Copy name
    memcpy(entry->bytes + entry->name_ofs, key, key_size);

    return entry;
}

// Find an entry by name
static entry_t *bdb_entry_get(uint8_t set, const char *name) {
    entry_t *entry = bdb_entry_first();
    while (entry) {
        if (entry->token == set) {
            if (strcmp((char *)(entry->bytes + entry->name_ofs), name) == 0)
                return entry;
        }
        entry = bdb_entry_next(entry);
    }
    return 0;
}

// Get count of DB entries
static uint16_t bdb_entry_count() {
    uint16_t count = 0;
    entry_t *entry = bdb_entry_first();
    while (entry) {
        count++;
        entry = bdb_entry_next(entry);
    }
    return count;
}

// Unset/Erase a DB entry
static void bdb_entry_unset(entry_t *entry) {
    int size = bdb_entry_size(entry);
    memmove(bmem->db_start + size, bmem->db_start,
            (uint8_t *)entry - bmem->db_start);
    bmem->db_start += size;
}

// Clear all entries
static void bmem_db_clear() { bmem->db_start = bmem->db_end; }

// PUT "key", "value": Create a new (key, value) entry
static entry_t *bdb_entry_set(uint8_t set, const char *name, char *value,
                              bool is_cstr) {
    // Remove the entry if it already exists
    entry_t *entry = bdb_entry_get(set, name);
    if (entry != 0)
        bdb_entry_unset(entry);

    // Only unset key if no value given
    if (value == 0)
        return 0;

    // Create the entry
    uint16_t len = is_cstr ? strlen(value) : string_len(value);
    entry = bdb_entry_new(set, name, (uint8_t *)value, len);
    if (entry == 0)
        goto finalize;

    // set string length
    entry->string[0] = len & 0xff;
    entry->string[1] = len >> 8;

    // set string terminator
    entry->string[len + 2] = 0;
    if (!value)
        goto finalize;

    // Copy the string value
    memcpy(string_cstr(entry->string), is_cstr ? value : string_cstr(value),
           len);

finalize:
    return entry;
}

static char *bdb_get_keys(uint8_t set) {
    char *string = bmem_string_alloc(0);
    char key[B_NAME_SIZE_MAX + 4];
    key[B_NAME_SIZE_MAX - 1 + 4] = 0;
    uint16_t size = 0;
    entry_t *entry = bdb_entry_first();
    while (entry) {
        if (entry->token == set) {
            char *cname = (char *)entry->bytes + entry->name_ofs;
            strncpy(string_cstr(key), cname, B_NAME_SIZE_MAX - 1);
            size = strlen(string_cstr(key)) + 2;
            key[2 + size - 2] = '\r';
            key[2 + size - 1] = '\n';
            key[0] = size & 0xff;
            key[1] = size >> 8;
            string_concat(&string, key);
        }
        entry = bdb_entry_next(entry);
    }
    return string;
}
