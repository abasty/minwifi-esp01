#include "bio.h"
#include "bmemory.h"
#include "os.h"
#include "bdb.h"

#ifdef MINITEL
#include "tty-minitel.h"
#else
#include "tty-vt100.h"
#endif

#define BASTOS_NETWORK_COUNT (20)
#define BASTOS_SERVER_COUNT (20)

#define SERVER_NAME_MAX_SIZE (16)
#define SERVER_HOST_MAX_SIZE (64)
#define SERVER_PATH_MAX_SIZE (16)
#define SERVER_LOGIN_MAX_SIZE (16)
#define SERVER_SECRET_MAX_SIZE (64)

// OS WiFi variables
char g_net_connected_ssid[20] = ""; // 20 first characters of SSID
char g_net_connected_ip[16] = "";

void os_db_save(void)
{
    int fd = hal_open("CONFIG.$$$", B_CREAT | B_WRONLY);
    if (fd < 0)
        return;

    // Write DB size
    uint16_t db_size = bmem->db_end - bmem->db_start;
    if (hal_write(fd, &db_size, sizeof(db_size)) < 0) {
        goto err;
    }

    // Write DB
    if (hal_write(fd, bmem->db_start, db_size) < 0) {
        goto err;
    }

err:
    if (fd >= 0) {
        hal_close(fd);
    }
}

void os_db_load(void)
{
    // Remove memory records
    bmem_db_clear();

    int fd = hal_open("CONFIG.$$$", B_RDONLY);
    if (fd < 0)
        return;

    // Read DB size
    int16_t db_size;
    if (hal_read(fd, &db_size, sizeof(db_size)) != sizeof(db_size))
        goto finalize;

    // Check DB size
    if (db_size > BASTOS_DB_SIZE)
        goto finalize;

    // Read DB records from mass storage
    bmem->db_start = bmem->db_end - db_size;
    hal_read(fd, bmem->db_start, db_size);

finalize:
    hal_close(fd);
}

/**
 * @brief Print network and add it to SSID array
 *
 * @param i Index of the network in the list
 * @param ssid SSID of the network
 * @param encryption Encryption type (0: None, 1: WEP, 2: WPA, 3: WPA2)
 * @param rssi Signal strength in dBm
 */
void os_wifi_print_network(int i, const char *ssid, uint8_t encryption, int32_t rssi)
{

    // Print the list of networks
    hal_print_integer("%2d ", i);
    hal_print_integer("%3d ", rssi);
    hal_print_string(ssid);
    hal_print_string("\r\n");

    // Add the network to the SSID array (SSID$(i))
    // Note: If i does not exist in the array, cstr is 0 and the SSID is not
    // added to the array
    uint16_t len = WIFI_SSID_MAX_SIZE;
    char *cstr = bmem_ssid_get_from_id(i);
    if (cstr)
    {
        strncpy(cstr, ssid, len - 1);
        cstr[len - 1] = '\0';
    }
}

void os_wifi_scan(void)
{
    // Display scanning status
    hal_print_string(LINE0 INV BLINK "Scanning..." CLEOL NORMAL "\n");

    // Scan and display Wi-Fi networks
    bmem_ssid_array_new();
    hal_print_string("\r\n" INV "ID dBm SSID" CLEOL " " NORMAL "\r\n");
    int n = hal_wifi_scan();

    hal_print_integer("\r\n%d network(s)" CLEOL NORMAL "\r\n\r\n" LINE0 CLEOL "\n", n);
}

int os_wifi_connect(const char *ssid)
{
    bool use_db = false;
    char secret[WIFI_SECRET_MAX_SIZE] = "";

    entry_t *entry = bdb_entry_get(DB_WIFI_SET, ssid);
    if (entry)
    {
        strncpy(secret, string_cstr(entry->string), WIFI_SECRET_MAX_SIZE - 1);
        secret[WIFI_SECRET_MAX_SIZE - 1] = 0;
        use_db = true;
    }

    if (!use_db)
    {
        hal_print_string(LINE0 INV "Password: " CLEOL);
        if (os_get_string(secret, sizeof(secret), '*') < 0)
        {
            hal_print_string(LINE0 CLEOL "\r\n");
            return -1;
        }
    }
    hal_print_string(LINE0 INV BLINK "Connecting to ");
    hal_print_string(ssid);
    hal_print_string(CLEOL NORMAL "\n");

    int ret = hal_wifi_connect(ssid, secret);
    if (ret == 0)
    {
        if (!use_db)
        {
            bdb_entry_set(DB_WIFI_SET, ssid, secret, true);
            os_db_save();
        }
    }

#ifdef MINITEL
    hal_print_string(LINE0 CLEOL "\r\n");
#endif
    return ret;
}

int os_wifi_erase(const char *ssid)
{
    bdb_entry_set(DB_WIFI_SET, ssid, 0, true);
    os_db_save();
    return 0;
}

void os_wifi_set_info(const char *ssid, const char *ip)
{
    if (ssid)
    {
        strncpy(g_net_connected_ssid, ssid, sizeof(g_net_connected_ssid) - 1);
        g_net_connected_ssid[sizeof(g_net_connected_ssid) - 1] = '\0';
    }
    if (ip)
    {
        strncpy(g_net_connected_ip, ip, sizeof(g_net_connected_ip) - 1);
        g_net_connected_ip[sizeof(g_net_connected_ip) - 1] = '\0';
    }
}

void os_wifi_status(void)
{
    hal_print_string("\r\n" INV "IP              SSID" CLEOL " " NORMAL "\r\n");
    if (!hal_wifi_is_connected())
    {
        hal_print_string("Not connected");
    }
    else
    {
        hal_print_string(g_net_connected_ip);
        uint8_t len = strlen(g_net_connected_ip);
        for (int i = 16 - len; i > 0; i--)
            hal_print_string(" ");
        hal_print_string(g_net_connected_ssid);
    }
    hal_print_string("\r\n\r\n");
}

void os_db_list(uint8_t set)
{
    if (set != DB_WIFI_SET)
        hal_print_string("\r\n" INV "Key      Value" CLEOL " " NORMAL "\r\n");
    else
        hal_print_string("\r\n" INV "SSID" CLEOL " " NORMAL "\r\n");

    int n = 0;
    entry_t *entry = bdb_entry_first();
    while (entry)
    {
        if (entry->token == set)
        {
            char line[40];
            if (set != DB_WIFI_SET)
                snprintf(line, 40, "%-8.8s %s", entry->bytes + entry->name_ofs, string_cstr(entry->string));
            else
                snprintf(line, 40, "%s", entry->bytes + entry->name_ofs);
            line[39] = 0;
            hal_print_string(line);
            hal_print_string("\r\n");
            n++;
        }
        entry = bdb_entry_next(entry);
    }
    hal_print_integer("\r\n%d record(s)" CLEOL NORMAL "\r\n\r\n" LINE0 CLEOL "\n", n);
}

void os_db_erase(uint8_t set, const char *name)
{
    entry_t *entry = bdb_entry_get(set, name);
    if (entry)
    {
        bdb_entry_unset(entry);
        os_db_save();
    }
}

int os_get_string(char *buf, int size, char secret_char)
{
    int i = 0;
    while (i < size - 1)
    {
        uint8_t key = os_get_key();
        if (key == 0) // No key pressed
            continue;
        if (key == 3) // Ctrl+C
        {
            return -1; // Cancel the input
        }
        if (key == 0x7F) // DEL key
        {
            if (i > 0)
            {
                i--;
                hal_print_string("\b \b"); // Erase last character
            }
            continue;
        }
        if (key == '\r' || key == '\n') // Enter key
        {
            break;
        }
        if (key >= 32 && key <= 126) // Printable characters
        {
            buf[i++] = key;
            const char key_str[2] = {secret_char ? secret_char : key, '\0'};
            hal_print_string(key_str);
        }
    }
    buf[i] = '\0'; // Null-terminate the string
    return i;      // Return the number of characters read
}

uint8_t os_get_key()
{
    static bool fkey = false;
    uint8_t key = hal_get_key();

    if (key == 0)
        return 0; // No key pressed

    if (key == 0x13)
    {
        // Function key pressed
        fkey = true;
        key = 0;
    }
    else
    {
        if (fkey)
        {
            if (key == 0x47)
            {               // CORRECTION key
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x45)
            {            // ANNULATION key
                key = 3; // Convert to Ctrl+C
            }
            else if (key == 0x59)
            {            // CX/FIN key
                key = 0; // Ignore it
                hal_print_string("\x13\x59"); // Send CX/Fin to terminal
            }
            else
            {               // ENVOI and other function keys
                key = '\r'; // Convert to Enter
            }
            fkey = false;
        }
        else
        {
            if (key == 0x08)
            {
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x1b)
            {
                key = 3; // Convert ESC to Ctrl+C
            }
        }
    }
    return key;
}

int os_connect(uint8_t set, const char *name, const char* urn)
{
    int ret = -1;

    // Get configuration if needed
    entry_t *entry = name ? bdb_entry_get(set, name) : 0;
    bool use_db = entry != 0 && urn == 0;
    urn = use_db ? string_cstr(entry->string) : urn;
    if (!urn)
        goto finalize;

    split_t *split = bdb_urn_split(urn);
    if (split->proto == 0)
        goto finalize;

    // Connect to the host
    ret = hal_net_connect(split);
    if (ret >= 0) {
        if (set == DB_MIN_SET) {
            hal_print_string(P_ROULEAU_OFF);
        } else {
            hal_print_string("Connected\r\n");
        }
    }

    if (!use_db && name && *name > 0) {
        bdb_entry_set(set, name, (char*) urn, true);
        os_db_save();
    }

finalize:
    return ret;
}

static void os_disconnect(void)
{
    hal_net_disconnect(bmem->bstate.sock);
    bmem->bstate.sock = -1;

    hal_print_string("\r\n" P_ROULEAU_ON);
    if (!eval_running())
    {
        hal_print_string(CON G0 INK7 "Pourquoi Ready\r\n");
    }
}

void os_cat(void)
{
    hal_print_string("\r\nDrive: A\r\n\r\n");
    size_t total = hal_cat();
    hal_print_integer("\r\n%3uK free\r\n\r\n", total / 1024);
}

void os_cat_file(const char *filename, size_t size)
{
    char buffer[40];
    char *ext = strchr(filename, '.');
    int n = ext ? (ext - filename) : strlen(filename);
    ext = ext ? ext + 1 : "";
    snprintf(buffer, sizeof(buffer), "%-8.*s.%-3s %zu\r\n", n, filename, ext, size);
    hal_print_string(buffer);
}

static void os_loop_connected()
{
    static bool fkey = false;
    uint8_t buffer[NET_BUFFER_MAX];

    // Read data on socket in a non blocking mode
    int ret = hal_net_recv(bmem->bstate.sock, buffer, sizeof(buffer));
    if (ret < 0)
    {
        // If error on socket: exit the connected mode
        os_disconnect();
    }
    else if (ret > 0)
    {
        // If chars on socket: forward chars to screen (print)
        hal_print_buffer(buffer, ret);
    }

    uint8_t key = hal_get_key();
    // If keyboard has not char: return
    if (key == 0)
        return;

    // Send char to server through the socket
    ret = hal_net_send(bmem->bstate.sock, &key, 1);
    if (ret < 0)
    {
        // If error on socket: exit the connected mode
        os_disconnect();
    }

    // If Cx/Fin: close socket [exit the connected mode]
    if (key == 0x13)
    {
        fkey = true;
    }
    else
    {
        if (fkey)
        {
            if (key == 'Y') // CX/Fin
            {
                os_disconnect();
            }
            fkey = false;
        }
    }
}

static void os_loop_basic()
{
    char key = os_get_key();
    bastos_send_keys((char *)&key, key != 0 ? 1 : 0, true);
    bastos_loop();
    if (bastos_is_reset())
    {
        bastos_done();
        hal_reset();
    }
}

void os_loop()
{
    if (bmem->bstate.sock >= 0)
    {
        os_loop_connected();
    }
    else
    {
        os_loop_basic();
    }
}

void os_setup(void)
{
    // Init Basic and display BASTOS banner
    bastos_init();
    bastos_send_keys("bastos\n", 7, false);
}
