void os_wifi_remove_unknown_networks(void)
{
    // Remove all networks that are not known
    for (int16_t i = g_known_net_count; i < g_net_count; i++)
    {
        free(g_net_store[i]);
        g_net_store[i] = NULL;
    }
    g_net_count = g_known_net_count;
}

static void wifi_remove_all_networks(void)
{
    // Free all networks in the store
    for (int16_t i = 0; i < g_net_count; i++)
    {
        if (g_net_store[i])
        {
            free(g_net_store[i]);
            g_net_store[i] = NULL;
        }
    }
    g_net_count = 0;
    g_known_net_count = 0;
}

network_t *os_wifi_get_network_by_ssid(const char *ssid)
{
    for (int i = 0; i < g_net_count; i++)
        if (g_net_store[i] && strcmp(g_net_store[i]->ssid, ssid) == 0)
            return g_net_store[i];
    return NULL;
}

network_t *os_wifi_get_network_by_id(int16_t id)
{
    int16_t n = 0;
    for (int16_t i = 0; i < g_net_count; i++)
    {
        network_t *net = g_net_store[i];
        if (net->dBm != -128)
        {
            n++;
            if (n == id)
            {
                return net; // Return the network with the given ID
            }
        }
    }
    return NULL; // Network with the given ID not found
}

static void wifi_print_network(int n, const network_t *net)
{
    hal_print_integer("%2d ", n);
    hal_print_integer("%3d ", net->dBm);
    hal_print_string(net->ssid);
    hal_print_string("\r\n");
}

void os_wifi_list_networks(void)
{
    // Sort networks before listing
    wifi_sort_networks();

    hal_print_string("\r\n" INV "ID dBm SSID" CLEOL " " NORMAL "\r\n");

    // Parse all newtorks and print those with dBm != -128
    int n = 0;
    for (int16_t i = 0; i < g_net_count; i++)
    {
        network_t *net = g_net_store[i];
        if (net->dBm != -128)
        {
            wifi_print_network(++n, net);
        }
    }
    hal_print_integer("\r\n%d network(s)" CLEOL NORMAL "\r\n\r\nReady\r\n", n);
}

void os_wifi_add_network(const char *ssid, uint8_t encryption, int32_t rssi)
{
    // Check if the network already exists
    network_t *existing_net = os_wifi_get_network_by_ssid(ssid);
    if (existing_net)
    {
        // Update existing network
        existing_net->encryption = encryption;
        existing_net->dBm = rssi;
        return;
    }
    // If the network does not exist, create a new one
    wifi_new_network(ssid, encryption, rssi);
}

int os_wifi_connect(network_t *net)
{
    char secret[64];
    if (net->count == 0)
    {
        hal_print_string(LINE0 INV "Password: " CLEOL);
        os_get_string(secret, sizeof(secret));
    }
    else
    {
        strncpy(secret, net->secret, sizeof(secret) - 1);
        secret[sizeof(secret) - 1] = '\0'; // Ensure null-termination
    }
    hal_print_string(LINE0 INV BLINK "Connecting to ");
    hal_print_string(net->ssid);
    hal_print_string(CLEOL NORMAL "\n");

    int ret = hal_wifi_connect(net->ssid, secret);
    if (ret != 0)
    {
        hal_print_string("Failed to connect to " );
    }
    else
    {
        hal_print_string("Connected to ");
        strncpy(net->secret, secret, sizeof(net->secret) - 1);
        net->secret[sizeof(net->secret) - 1] = '\0';
        net->count++;
        wifi_sort_networks();
        g_known_net_count++;
        // TODO: Save config
    }

    hal_print_string(net->ssid);
    hal_print_string("\r\n");
#ifdef MINITEL
    hal_print_string(LINE0 CLEOL "\r\n");
#endif
    return ret;
}

int os_get_string(char *buf, int size)
{
    int i = 0;
    while (i < size - 1)
    {
        uint8_t key = os_get_key();
        if (key == 0) // No key pressed
            continue;
        if (key == 3) // Ctrl+C
        {
            hal_print_string("\nOperation cancelled.\n");
            return -1; // Cancel the input
        }
        if (key == 0x7F) // DEL key
        {
            if (i > 0)
            {
                i--;
                hal_print_string("\b \b"); // Erase last character
            }
            continue;
        }
        if (key == '\r' || key == '\n') // Enter key
        {
            break;
        }
        if (key >= 32 && key <= 126) // Printable characters
        {
            buf[i++] = key; // Store the character
            hal_print_string((const char[]){key, '\0'}); // Print the character
        }
    }
    buf[i] = '\0'; // Null-terminate the string
    return i; // Return the number of characters read
}

uint8_t os_get_key()
{
    static bool fkey = false;
    uint8_t key = hal_get_key();

    if (key == 0)
        return 0; // No key pressed

    if (key == 0x13)
    {
        // Function key pressed
        fkey = true;
        key = 0;
    }
    else
    {
        if (fkey)
        {
            if (key == 0x47)
            {               // CORRECTION key
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x45)
            {            // ANNULATION key
                key = 3; // Convert to Ctrl+C
            }
            else
            {               // ENVOI and other function keys
                key = '\r'; // Convert to Enter
            }
            fkey = false;
        }
        else
        {
            if (key == 0x08)
            {
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x1b)
            {
                key = 3; // Convert ESC to Ctrl+C
            }
        }
    }
    return key;
}

void os_bootstrap(void)
{
    // Remove all networks
    wifi_remove_all_networks();

    // Load config
    int fd = hal_open("$$$CONFIG$$$", B_RDONLY);
    if (fd >= 0)
    {
        network_t net;
        while (hal_read(fd, &net, sizeof(network_t)) == sizeof(network_t))
        {
            network_t *new_net = wifi_new_network(net.ssid, net.encryption, -128);
            if (new_net)
            {
                new_net->count = net.count;
                strncpy(new_net->secret, net.secret, sizeof(new_net->secret) - 1);
                new_net->secret[sizeof(new_net->secret) - 1] = '\0'; // Ensure null-termination
            }
        }
        hal_close(fd);
    }

    // Init Basic and display BASTOS banner
    bastos_init();
    bastos_send_keys("bastos\n", 7, false);
}
