#include "bio.h"
#include "os.h"

#ifdef MINITEL
#include "tty-minitel.h"
#else
#include "tty-vt100.h"
#endif

#define BASTOS_NETWORK_COUNT (100)

// OS variables
int16_t g_net_count = 0;
int16_t g_known_net_count = 0;
network_t *g_net_store[BASTOS_NETWORK_COUNT + 1] = {0};

static void wifi_sort_networks_by_count(int16_t first, int16_t last)
{
    // Sort networks by count of connections (descending)
    for (int16_t i = first; i < last; i++)
    {
        for (int16_t j = i + 1; j <= last; j++)
        {
            if (g_net_store[i]->count < g_net_store[j]->count)
            {
                // Swap networks
                network_t *temp = g_net_store[i];
                g_net_store[i] = g_net_store[j];
                g_net_store[j] = temp;
            }
        }
    }
}

static void wifi_sort_networks_by_dBm(int16_t first, int16_t last)
{
    // Sort networks by dBm (descending)
    for (int16_t i = first; i < last; i++)
    {
        for (int16_t j = i + 1; j <= last; j++)
        {
            if (g_net_store[i]->dBm < g_net_store[j]->dBm)
            {
                // Swap networks
                network_t *temp = g_net_store[i];
                g_net_store[i] = g_net_store[j];
                g_net_store[j] = temp;
            }
        }
    }
}

static void wifi_sort_networks(void)
{
    wifi_sort_networks_by_count(0, g_net_count - 1);
    wifi_sort_networks_by_dBm(0, g_known_net_count - 1);
    wifi_sort_networks_by_dBm(g_known_net_count, g_net_count - 1);
}

static network_t *wifi_new_network(const char *ssid, uint8_t encryption, int32_t rssi)
{
    if (g_net_count >= BASTOS_NETWORK_COUNT)
        return NULL;

    network_t *new_net = (network_t *)malloc(sizeof(network_t));
    if (!new_net)
        return NULL;

    // Initialize the new network
    new_net->dBm = rssi;
    new_net->encryption = encryption;
    new_net->count = 0;
    new_net->available = false;
    strncpy(new_net->ssid, ssid, sizeof(new_net->ssid) - 1);
    new_net->ssid[sizeof(new_net->ssid) - 1] = '\0';
    new_net->secret[0] = '\0';

    // Add the new network to the store
    g_net_store[g_net_count++] = new_net;

    return new_net;
}

static void wifi_remove_all_networks(void)
{
    // Free all networks in the store
    for (int16_t i = 0; i < g_net_count; i++)
    {
        if (g_net_store[i])
        {
            free(g_net_store[i]);
            g_net_store[i] = NULL;
        }
    }
    g_net_count = 0;
    g_known_net_count = 0;
}

static void wifi_print_network(int n, const network_t *net)
{
    if (!net->available)
    {
        hal_print_string(INK1);
    }
    hal_print_integer("%2d ", n);
    hal_print_integer("%3d ", net->dBm);
    hal_print_string(net->ssid);
    hal_print_string(INK7 "\r\n");
}

static void config_load(void)
{
    int fd = hal_open("$$$CONFIG$$$", B_RDONLY);
    if (fd >= 0)
    {
        network_t net;
        while (hal_read(fd, &net, sizeof(network_t)) == sizeof(network_t))
        {
            network_t *new_net = wifi_new_network(net.ssid, net.encryption, net.dBm);
            if (new_net)
            {
                new_net->count = net.count;
                strncpy(new_net->secret, net.secret, sizeof(new_net->secret) - 1);
                new_net->secret[sizeof(new_net->secret) - 1] = '\0';
                g_known_net_count++;
            }
        }
        hal_close(fd);
    }
}

static void config_save(void)
{
    int fd = hal_open("$$$CONFIG$$$", B_CREAT | B_WRONLY);
    if (fd >= 0)
    {
        for (int16_t i = 0; i < g_known_net_count; i++)
        {
            network_t *net = g_net_store[i];
            if (net) // Only save valid networks
            {
                hal_write(fd, net, sizeof(network_t));
            }
        }
        hal_close(fd);
    }
}

network_t *os_wifi_get_network_by_ssid(const char *ssid)
{
    for (int i = 0; i < g_net_count; i++)
        if (g_net_store[i] && strcmp(g_net_store[i]->ssid, ssid) == 0)
            return g_net_store[i];
    return NULL;
}

network_t *os_wifi_get_network_by_id(int16_t id)
{
    id--;
    if (id >= 0 && id < g_net_count)
    {
        return g_net_store[id];
    }
    return NULL;
}

void os_wifi_remove_unknown_networks(void)
{
    // Remove all networks that are not known
    for (int16_t i = g_known_net_count; i < g_net_count; i++)
    {
        free(g_net_store[i]);
        g_net_store[i] = NULL;
    }
    g_net_count = g_known_net_count;
}

void os_wifi_mark_not_available(void)
{
    for (int16_t i = 0; i < g_net_count; i++)
    {
        g_net_store[i]->available = false;
    }
}

void os_wifi_list_networks(void)
{
    // Sort networks before listing
    wifi_sort_networks();

    hal_print_string("\r\n" INV "ID dBm SSID" CLEOL " " NORMAL "\r\n");

    // Parse all networks
    int n = 0;
    for (int16_t i = 0; i < g_net_count; i++)
    {
        network_t *net = g_net_store[i];
        wifi_print_network(++n, net);
    }
    hal_print_integer("\r\n%d network(s)" CLEOL NORMAL "\r\n\r\nReady\r\n", n);
}

void os_wifi_add_network(const char *ssid, uint8_t encryption, int32_t rssi)
{
    // Check if the network already exists
    network_t *net = os_wifi_get_network_by_ssid(ssid);
    if (net)
    {
        // Update existing network
        net->available = true;
        net->encryption = encryption;
        net->dBm = rssi;
        return;
    }
    else
    {
        // If the network does not exist, create a new one
        net = wifi_new_network(ssid, encryption, rssi);
    }
    net->available = true;
}

int os_wifi_connect(network_t *net)
{
    char secret[64];
    if (net->count == 0)
    {
        hal_print_string(LINE0 INV "Password: " CLEOL);
        if (os_get_string(secret, sizeof(secret), '*') < 0)
        {
            hal_print_string(LINE0 CLEOL "\r\n");
            return -1;
        }
    }
    else
    {
        strncpy(secret, net->secret, sizeof(secret) - 1);
        secret[sizeof(secret) - 1] = '\0';
    }
    hal_print_string(LINE0 INV BLINK "Connecting to ");
    hal_print_string(net->ssid);
    hal_print_string(CLEOL NORMAL "\n");

    int ret = hal_wifi_connect(net->ssid, secret);
    if (ret != 0)
    {
        hal_print_string("Failed to connect to ");
    }
    else
    {
        hal_print_string("Connected to ");
        strncpy(net->secret, secret, sizeof(net->secret) - 1);
        net->secret[sizeof(net->secret) - 1] = '\0';
        if (net->count < 255)
        {
            net->count++;
            if (net->count == 1)
                g_known_net_count++;
        }
        wifi_sort_networks();
        config_save();
    }

    hal_print_string(net->ssid);
    hal_print_string("\r\n");
#ifdef MINITEL
    hal_print_string(LINE0 CLEOL "\r\n");
#endif
    return ret;
}

int os_wifi_erase(network_t *net)
{
    if (!net)
        return -1;

    // Find the index of the network in g_net_store
    int16_t index = -1;
    for (int16_t i = 0; i < g_net_count; i++)
    {
        if (g_net_store[i] == net)
        {
            index = i;
            break;
        }
    }
    if (index == -1)
        return -1;

    // Free the network and remove it from the store
    free(g_net_store[index]);
    g_net_store[index] = NULL;

    // Shift remaining networks down
    for (int16_t i = index; i < g_net_count - 1; i++)
    {
        g_net_store[i] = g_net_store[i + 1];
    }
    g_net_store[g_net_count - 1] = NULL;
    g_net_count--;

    // If the removed network was a known network, decrease the known network
    // count
    if (index < g_known_net_count)
    {
        g_known_net_count--;
        // Shift known networks count if needed
        // (already handled by shifting above)
    }

    // Save updated config
    config_save();

    return 0;
}

int os_get_string(char *buf, int size, char secret_char)
{
    int i = 0;
    while (i < size - 1)
    {
        uint8_t key = os_get_key();
        if (key == 0) // No key pressed
            continue;
        if (key == 3) // Ctrl+C
        {
            return -1; // Cancel the input
        }
        if (key == 0x7F) // DEL key
        {
            if (i > 0)
            {
                i--;
                hal_print_string("\b \b"); // Erase last character
            }
            continue;
        }
        if (key == '\r' || key == '\n') // Enter key
        {
            break;
        }
        if (key >= 32 && key <= 126) // Printable characters
        {
            buf[i++] = key; // Store the character
            if (secret_char == 0)
            {
                hal_print_string((const char[]){key, '\0'}); // Print the character
            }
            else
            {
                hal_print_string((const char[]){secret_char, '\0'});
            }
        }
    }
    buf[i] = '\0'; // Null-terminate the string
    return i;      // Return the number of characters read
}

uint8_t os_get_key()
{
    static bool fkey = false;
    uint8_t key = hal_get_key();

    if (key == 0)
        return 0; // No key pressed

    if (key == 0x13)
    {
        // Function key pressed
        fkey = true;
        key = 0;
    }
    else
    {
        if (fkey)
        {
            if (key == 0x47)
            {               // CORRECTION key
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x45)
            {            // ANNULATION key
                key = 3; // Convert to Ctrl+C
            }
            else
            {               // ENVOI and other function keys
                key = '\r'; // Convert to Enter
            }
            fkey = false;
        }
        else
        {
            if (key == 0x08)
            {
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x1b)
            {
                key = 3; // Convert ESC to Ctrl+C
            }
        }
    }
    return key;
}

void os_setup(void)
{
    // Remove all networks
    wifi_remove_all_networks();

    // Load config
    config_load();

    // Init Basic and display BASTOS banner
    bastos_init();
    bastos_send_keys("bastos\n", 7, false);
}

static void os_disconnect(void)
{
    hal_disconnect(bmem->bstate.sock);
    bmem->bstate.sock = -1;
    hal_print_string("Ready\r\n");
}

static void os_loop_connected()
{
    static bool fkey = false;
    uint8_t buffer[128];

    // Read data on socket in a non blocking mode
    int ret = hal_net_recv(buffer, sizeof(buffer));
    if (ret < 0)
    {
        // If error on socket: exit the connected mode
        os_disconnect();
    }
    else
    {
        // If chars on socket: forward chars to screen (print)
        hal_print_buffer(buffer, ret);
    }

    uint8_t key = hal_get_key();
    // If keyboard has not char: return
    if (key == 0)
        return;

    // Send char to server through the socket
    ret = hal_net_send(&key, 1);
    if (ret < 0)
    {
        // If error on socket: exit the connected mode
        os_disconnect();
    }

    // If Cx/Fin: close socket [exit the connected mode]
    if (key == 0x13)
    {
        fkey = true;
    }
    else
    {
        if (fkey)
        {
            if (key == 'I') // CX/Fin
            {
                os_disconnect();
            }
            fkey = false;
        }
    }
}

static void os_loop_basic()
{
    char key = os_get_key();
    bastos_send_keys((char *)&key, key != 0 ? 1 : 0, true);
    bastos_loop();
    if (bastos_is_reset())
    {
        bastos_done();
        hal_reset();
    }
}

void os_loop()
{
    if (bmem->bstate.sock >= 0)
    {
        os_loop_connected();
    }
    else
    {
        os_loop_basic();
    }
}
