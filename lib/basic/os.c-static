#define AUTOEXEC_FILE "autoexec.bas"
#define AUTOLOAD_DB_FILE "autoload.db"

#define WS_STATE_READ_HEADER0  (0U)
#define WS_STATE_READ_HEADER1  (1U)
#define WS_STATE_READ_EXT_LEN0 (2U)
#define WS_STATE_READ_EXT_LEN1 (3U)
#define WS_STATE_READ_MASK_KEY (5U)
#define WS_STATE_READ_PAYLOAD  (6U)

// OS WiFi variables
// FIXME (Move to Basic memory)
static char g_wifi_connected_ssid[20] = ""; // 20 first characters of SSID
static char g_wifi_connected_ip[16] = "";
static char g_ftp_connected_host[32] = "";
static uint8_t g_proto = 0;

// WebSocket state structure
struct ws_state_s {
    uint8_t state;
    uint16_t read;
    uint8_t mask_key[4];
    uint16_t payload_remain;
    uint8_t fin;
    uint8_t fragmented;
    uint8_t ping_payload[125];
    uint16_t ping_size;
};

static struct ws_state_s g_ws_state = {0};

static int g_ftp_fd = -1;

static void os_set_redirect(int fd) { bmem->output_fd = fd; }

// While active, redirects os_redir_print_* output into bmem->io_buffer
// instead of the terminal — used by bastos_load_edit_line() (bio.c), the
// shared staging step behind both EDIT <line_no> and the Up-arrow recall
// of a stored numbered line, to build the line directly where it will be
// edited, not through the terminal or a BASIC variable. The caller is
// responsible for io_buffer's content before/after.
static void os_set_redirect_prefill(bool active) {
    bmem->output_prefill = active ? 1 : 0;
}

static int os_concat_buffer(const char *name, const char *buffer, int n) {
    var_t *var = bmem_var_get(name);
    if (!var || n == 0)
        return 0;

    int l = string_len(var->string);
    char *value = bmem_string_alloc(l + n);

    char *dst = value + 2;
    const char *src = string_cstr(var->string);
    int i = l;
    while (i > 0) {
        *dst++ = *src++;
        i--;
    }
    src = buffer;
    i = n;
    while (i > 0) {
        *dst++ = *src++;
        i--;
    }
    *dst = 0;

    bmem_var_string_set(name, value, false);
    return n;
}

static int os_redir_print_to_prefill(const char *buffer, int n) {
    size_t len = strlen((char *)bmem->io_buffer);
    int room = (int)(sizeof(bmem->io_buffer) - 1 - len);
    if (room < 0)
        room = 0;
    int copy = n < room ? n : room;
    if (copy > 0) {
        memcpy(bmem->io_buffer + len, buffer, copy);
        bmem->io_buffer[len + copy] = 0;
    }
    return copy;
}

static int os_redir_print_buffer(const char *buffer, int n) {
    // Redir to fd
    if (bmem->output_fd >= 0)
        return hal_write(bmem->output_fd, buffer, n);

    // Redir to var
    if (*bmem->output_var != 0)
        return os_concat_buffer(bmem->output_var, buffer, n);

    // Redir to the edit staging area (bmem->io_buffer itself)
    if (bmem->output_prefill)
        return os_redir_print_to_prefill(buffer, n);

    return hal_print_buffer((uint8_t *) buffer, n);
}

static int os_redir_print_string(const char *s) {
    if (bmem->output_fd >= 0 || *bmem->output_var != 0 || bmem->output_prefill)
        return os_redir_print_buffer(s, strlen(s));

    return hal_print_string(s);
}

static int os_redir_print_integer(const char *format, int i) {
    if (bmem->output_fd >= 0 || *bmem->output_var != 0 || bmem->output_prefill) {
        char buffer[80];
        int len = snprintf(buffer, sizeof(buffer), format, i);
        return os_redir_print_buffer(buffer, len);
    }
    return hal_print_integer(format, i);
}

static int os_redir_print_float(float f) {
    if (bmem->output_fd >= 0 || *bmem->output_var != 0 || bmem->output_prefill) {
        char buffer[16];
        int len = snprintf(buffer, sizeof(buffer), "%g", f);
        return os_redir_print_buffer(buffer, len);
    }
    return hal_print_float(f);
}

static void os_db_save(void) {
    int fd = hal_open(AUTOLOAD_DB_FILE, B_CREAT | B_WRONLY);
    if (fd < 0)
        return;

    // Write DB size
    uint16_t db_size = bmem->db_end - bmem->db_start;
    if (hal_write(fd, &db_size, sizeof(db_size)) < 0) {
        goto err;
    }

    // Write DB
    if (hal_write(fd, bmem->db_start, db_size) < 0) {
        goto err;
    }

err:
    if (fd >= 0) {
        hal_close(fd);
    }
}

static void os_db_load(void) {
    // Remove memory records
    bmem_db_clear();

    int fd = hal_open(AUTOLOAD_DB_FILE, B_RDONLY);
    if (fd < 0)
        return;

    // Read DB size
    int16_t db_size;
    if (hal_read(fd, &db_size, sizeof(db_size)) != sizeof(db_size))
        goto finalize;

    // Check DB size
    if (db_size > BASTOS_DB_SIZE)
        goto finalize;

    // Read DB records from mass storage
    bmem->db_start = bmem->db_end - db_size;
    hal_read(fd, bmem->db_start, db_size);

finalize:
    hal_close(fd);
}

static void os_autoexec(void) {
    hal_print_string(MODE_INIT_STRING);

    char autochar[2] = {'1', 0};
    entry_t *entry = bdb_entry_get(DB_CONFIG_SET, "autoexec");
    if (entry) {
        strncpy(autochar, string_cstr(entry->string), 1);
        autochar[1] = 0;
        bdb_entry_set(DB_CONFIG_SET, "autoexec", 0, true);
        os_db_save();
    }
    if (autochar[0] == '1' && bastos_load(AUTOEXEC_FILE) == BERROR_NONE) {
        running_state_clear();
        bmem->bstate.pc = bmem_prog_first_line();
        bmem->bstate.running = bmem->bstate.pc != 0;
    } else {
        // System-injected, not something the user typed: don't let it
        // become an Up-arrow recall target once bastos_input() processes it.
        bmem->io_no_recall = 1;
        bastos_send_keys("bastos\n", 7, false);
    }
}

/**
 * @brief Print network and add it to SSID array
 *
 * @param i Index of the network in the list
 * @param ssid SSID of the network
 * @param encryption Encryption type (0: None, 1: WEP, 2: WPA, 3: WPA2)
 * @param rssi Signal strength in dBm
 */
void os_wifi_print_network(int i, const char *ssid, uint8_t encryption,
                           int32_t rssi) {

    // Print the list of networks
    os_redir_print_integer("%2d ", i);
    os_redir_print_integer("%3d ", rssi);
    os_redir_print_string(ssid);
    os_redir_print_string("\r\n");

    // Add the network to the SSID array (SSID$(i))
    // Note: If i does not exist in the array, cstr is 0 and the SSID is not
    // added to the array
    uint16_t len = WIFI_SSID_MAX_SIZE;
    char *cstr = bmem_ssid_get_from_id(i);
    if (cstr) {
        strncpy(cstr, ssid, len - 1);
        cstr[len - 1] = '\0';
    }
}

static void os_wifi_scan(void) {
    // Display scanning status
    os_redir_print_string(LINE0 INV BLINK "Scanning..." CLEOL NORMAL "\n");

    // Scan and display Wi-Fi networks
    bmem_ssid_array_new();
    os_redir_print_string("\r\n" INV "ID dBm SSID" CLEOL " " NORMAL "\r\n");
    int n = hal_wifi_scan();

    os_redir_print_integer(
        "\r\n%d network(s)" CLEOL NORMAL "\r\n\r\n" LINE0 CLEOL "\n", n);
}

static int os_wifi_connect(const char *ssid) {
    bool use_db = false;
    char secret[WIFI_SECRET_MAX_SIZE] = "";

    entry_t *entry = bdb_entry_get(DB_WIFI_SET, ssid);
    if (entry) {
        strncpy(secret, string_cstr(entry->string), WIFI_SECRET_MAX_SIZE - 1);
        secret[WIFI_SECRET_MAX_SIZE - 1] = 0;
        use_db = true;
    }

    if (!use_db) {
        os_redir_print_string(LINE0 INV "Password: " CLEOL);
        if (os_get_string(secret, sizeof(secret), '*') < 0) {
            os_redir_print_string(LINE0 CLEOL "\r\n");
            return -1;
        }
    }
    os_redir_print_string(LINE0 INV BLINK "Connecting to ");
    os_redir_print_string(ssid);
    os_redir_print_string(CLEOL NORMAL "\n");

    int ret = hal_wifi_connect(ssid, secret);
    if (ret == 0) {
        if (!eval_running()) {
            hal_print_string("OK\r\n");
        }
        if (!use_db) {
            bdb_entry_set(DB_WIFI_SET, ssid, secret, true);
            os_db_save();
        }
    }

#ifdef MINITEL
    os_redir_print_string(LINE0 CLEOL "\r\n");
#endif
    return ret;
}

static int os_wifi_erase(const char *ssid) {
    bdb_entry_set(DB_WIFI_SET, ssid, 0, true);
    os_db_save();
    return 0;
}

void os_wifi_set_info(const char *ssid, const char *ip) {
    if (ssid) {
        strncpy(g_wifi_connected_ssid, ssid, sizeof(g_wifi_connected_ssid) - 1);
        g_wifi_connected_ssid[sizeof(g_wifi_connected_ssid) - 1] = '\0';
    }
    if (ip) {
        strncpy(g_wifi_connected_ip, ip, sizeof(g_wifi_connected_ip) - 1);
        g_wifi_connected_ip[sizeof(g_wifi_connected_ip) - 1] = '\0';
    }
}

static void os_wifi_status(void) {
    os_redir_print_string("\r\n" INV "IP              SSID" CLEOL " " NORMAL
                          "\r\n");
    if (!hal_wifi_is_connected()) {
        os_redir_print_string("Not connected");
    } else {
        os_redir_print_string(g_wifi_connected_ip);
        uint8_t len = strlen(g_wifi_connected_ip);
        for (int i = 16 - len; i > 0; i--)
            os_redir_print_string(" ");
        os_redir_print_string(g_wifi_connected_ssid);
    }
    os_redir_print_string("\r\n\r\n");
}

static void os_ftp_status(void) {
    os_redir_print_string("\r\n" INV "FTP Host" CLEOL " " NORMAL "\r\n");

    // Check connection status
    if (*g_ftp_connected_host != 0 && g_ftp_fd < 0) {
        *g_ftp_connected_host = 0;
    }

    // Display connection status message
    if (*g_ftp_connected_host == 0) {
        os_redir_print_string("Not connected");
    } else {
        os_redir_print_string(g_ftp_connected_host);
    }
    os_redir_print_string("\r\n\r\n");
}

static void os_db_list(uint8_t set) {
    if (set != DB_WIFI_SET)
        os_redir_print_string("\r\n" INV "Key      Value" CLEOL " " NORMAL
                              "\r\n");
    else
        os_redir_print_string("\r\n" INV "SSID" CLEOL " " NORMAL "\r\n");

    int n = 0;
    entry_t *entry = bdb_entry_first();
    while (entry) {
        if (entry->token == set) {
            char line[40];
            if (set != DB_WIFI_SET)
                snprintf(line, 40, "%-8.8s %s", entry->bytes + entry->name_ofs,
                         string_cstr(entry->string));
            else
                snprintf(line, 40, "%s", entry->bytes + entry->name_ofs);
            line[39] = 0;
            os_redir_print_string(line);
            os_redir_print_string("\r\n");
            n++;
        }
        entry = bdb_entry_next(entry);
    }
    os_redir_print_integer(
        "\r\n%d record(s)" CLEOL NORMAL "\r\n\r\n" LINE0 CLEOL "\n", n);
}

static void os_db_erase(uint8_t set, const char *name) {
    entry_t *entry = bdb_entry_get(set, name);
    if (entry) {
        bdb_entry_unset(entry);
        os_db_save();
    }
}

static int os_get_string(char *buf, int size, char secret_char) {
    int i = 0;
    while (i < size - 1) {
        uint8_t key = os_get_key();
        if (key == 0) // No key pressed
            continue;
        if (key == 0x1b) // ESC
        {
            return -1; // Cancel the input
        }
        if (key == 0x7F) // DEL key
        {
            // FIXME: Use del_last_key()
            if (i > 0) {
                i--;
                os_redir_print_string("\b \b"); // Erase last character
            }
            continue;
        }
        // FIXME: Manage "Annulation", and use del_last_key()
        if (key == '\r' || key == '\n') // Enter key
        {
            break;
        }
        if (key >= 32 && key <= 126) // Printable characters
        {
            buf[i++] = key;
            const char key_str[2] = {secret_char ? secret_char : key, '\0'};
            os_redir_print_string(key_str);
        }
    }
    buf[i] = '\0'; // Null-terminate the string
    return i;      // Return the number of characters read
}

#define KEY_STATE_NORMAL (0)
#define KEY_STATE_SEP    (1)
#define KEY_STATE_ESC    (2)
#define KEY_STATE_CSI    (3)
#define KEY_STATE_CSI_2  (4)

#define KEY_CODE_SEP (0x13u)
#define KEY_CODE_ESC (0x1bu)
#define KEY_CODE_CSI (0x5bu)

static uint8_t os_get_key() {
    static int32_t state = KEY_STATE_NORMAL;

    uint8_t key = hal_get_key();

    if (key == 0)
        return 0;

    switch (state) {

    case KEY_STATE_NORMAL:
        if (key == KEY_CODE_SEP) {
            state = KEY_STATE_SEP;
            key = 0;
        } else if (key == KEY_CODE_ESC)  {
            state = KEY_STATE_ESC;
            key = 0;
        } else {
            // no key conversion
        }
        break;

    case KEY_STATE_SEP:
        if (key == 0x41) {
            // Convert Minitel ENVOI key to BASTOS Enter key
            key = '\r';
        } else if (key == 'G') {
            // Convert Minitel CORRECTION key to BASTOS DEL key
            key = 0x7F;
        } else if (key == 'E') {
            // Convert Minitel ANNULATION key to BASTOS Ctrl+A key
            key = 1;
        } else if (key == 'C') {
            // Convert Minitel REPETITION key to BASTOS Ctrl+B key
            key = 2;
        } else if (key == 'H') {
            // Convert Minitel SUITE key to BASTOS Ctrl+D key
            key = 4;
        } else if (key == 'B') {
            // Convert Minitel RETOUR key to BASTOS Ctrl+E key
            key = 5;
        } else if (key == 'F') {
            // Convert Minitel SOMMAIRE key to BASTOS Ctrl+F key
            key = 6;
        } else if (key == 'D') {
            // Convert Minitel GUIDE key to BASTOS Ctrl+N key
            key = 14;
        } else if (key == 'Y') {
            // Take action on Minitel CX/Fin key (send it to Minitel)
            key = 0;
            os_redir_print_string("\x13\x59");
        } else {
            // Other SEP keys are ignored by BASTOS
            key = 0;
        }
        state = KEY_STATE_NORMAL;
        break;

    case KEY_STATE_ESC:
        if (key == KEY_CODE_ESC) {
            // Double ESC generates BASTOS break (Same as CPC)
            // key = KEY_CODE_ESC;
            state = KEY_STATE_NORMAL;
        } else if (key == KEY_CODE_CSI) {
            // CSI sequence (arrow keys)
            key = 0;
            state = KEY_STATE_CSI;
        } else {
            // Forgot ESC sequence
            // FIXME: Filter ESC sequences w/ more than 2 bytes
            key = 0;
            state = KEY_STATE_NORMAL;
        }
        break;

    case KEY_STATE_CSI:
        if (key == 'A') {
            key = 0x0b; // up
        } else if (key == 'B') {
            key = 0x0a; // down
        } else if (key == 'C') {
            key = 0x09; // right
        } else if (key == 'D') {
            key = 0x08; // left
        } else if (key == 'H') {
            key = 0x1e; // Home
        } else if (key == '2') {
            key = 0;
            state = KEY_STATE_CSI_2;
            break;
        } else {
            // Forgot CSI sequence: INS / DEL sequences are filtered here, so
            // they are not available to BASTOS input / inkey$ / CLI
            key = 0;
        }
        state = KEY_STATE_NORMAL;
        break;

    case KEY_STATE_CSI_2:
        if (key == 'J') {
            key = 0x0c; // CLS
            bmem_screen_clear();
        } else {
            key = 0;
        }
        state = KEY_STATE_NORMAL;
        break;

    default:
        break;
    }

    return key;
}

static int os_ws_connect(int fd, split_t *urn) {
    // Simple WebSocket handshake implementation
    const char* path = urn->parts[URN_PART_PATH];
    // Generate a simple key (in production, this should be random)
    const char *ws_key = "dGhlIHNhbXBsZSBub25jZQ==";

    // Build WebSocket upgrade request
    char request[256];
    int len = snprintf(request, sizeof(request),
        "GET %s HTTP/1.1\r\n"
        "Host: %s\r\n"
        "Connection: Upgrade\r\n"
        "Upgrade: websocket\r\n"
        "Sec-WebSocket-Key: %s\r\n"
        "Sec-WebSocket-Version: 13\r\n"
        "\r\n",
        path && *path ? path : "/",
        urn->parts[URN_PART_HOST],
        ws_key);

    // Send upgrade request
    if (hal_net_send(fd, (const uint8_t *)request, len) < 0) {
        hal_net_disconnect(DB_MIN_SET, fd);
        return -1;
    }

    // Read and parse HTTP response headers
    char line[256];
    int line_idx = 0;
    uint64_t start_ms = hal_get_ms();
    int is_first_line = 1;

    while ((hal_get_ms() - start_ms) < 5000) {
        int n = hal_net_recv(fd, (uint8_t *)&line[line_idx], 1);

        if (n <= 0) {
            // Error or timeout waiting for data
            if (n < 0) {
                hal_net_disconnect(DB_MIN_SET, fd);
                return -1;
            }
            // n == 0, no data yet, continue waiting
            continue;
        }

        // Got one byte
        char c = line[line_idx];

        // Check for line end (\n or \r\n)
        if (c == '\n') {
            // Remove trailing \r if present
            if (line_idx > 0 && line[line_idx - 1] == '\r') {
                line_idx--;
            }
            line[line_idx] = 0;  // Null-terminate the line

            // Check if this is an empty line (end of headers)
            if (line_idx == 0) {
                // Empty line found, handshake complete
                return fd;
            }

            // Process the line
            if (is_first_line) {
                // Check first line for status code 101
                if (strncmp(line, "HTTP/1.1 101", 12) != 0 &&
                    strncmp(line, "HTTP/1.0 101", 12) != 0) {
                    // Status is not 101, handshake failed
                    hal_net_disconnect(DB_MIN_SET, fd);
                    return -1;
                }
                is_first_line = 0;
            }
            // For other header lines, just discard them (line_idx already = 0
            // after setting null term)

            // Reset for next line
            line_idx = 0;
        } else if (c != '\r') {
            // Regular character, add to line (skip \r)
            line_idx++;
            if (line_idx >= (int)sizeof(line) - 1) {
                // Line too long
                hal_net_disconnect(DB_MIN_SET, fd);
                return -1;
            }
        }
    }

    // Timeout reached
    hal_net_disconnect(DB_MIN_SET, fd);
    return -1;
}

static int os_ftp_read_response(int fd, char *line, size_t size, int *code)
{
    int line_idx = 0;
    uint64_t start_ms = hal_get_ms();

    while ((hal_get_ms() - start_ms) < 5000) {
        int n = hal_net_recv(fd, (uint8_t *)&line[line_idx], 1);

        if (n <= 0) {
            if (n < 0)
                return -1;
            continue;
        }

        char c = line[line_idx];

        if (c == '\n') {
            if (line_idx > 0 && line[line_idx - 1] == '\r')
                line_idx--;
            line[line_idx] = 0;

            // os_redir_print_buffer(line, line_idx);
            // os_redir_print_buffer("\r\n", 2);
            // Parse response code
            *code = strtol(line, NULL, 10);
            return 0;
        } else if (c != '\r') {
            line_idx++;
            if (line_idx >= (int)size - 1)
                return -1;
        }
    }

    return -1; // Timeout
}

static int os_ftp_open_passive(int fd, int *data_fd)
{
    char line[256];
    char cmd[256];
    int code;

    // Send PASV command to enter passive mode
    snprintf(cmd, sizeof(cmd), "PASV\r\n");
    if (hal_net_send(fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        return -1;
    }

    // Read PASV response (expect 227)
    // Format: 227 Entering Passive Mode (h1,h2,h3,h4,p1,p2)
    if (os_ftp_read_response(fd, line, sizeof(line), &code) < 0 || code != 227) {
        return -1;
    }

    // Parse response to extract host and port
    // Format: 227 Entering Passive Mode (h1,h2,h3,h4,p1,p2)
    int h1, h2, h3, h4, p1, p2;
    if (sscanf(line, "227 %*[^(](%d,%d,%d,%d,%d,%d)", &h1, &h2, &h3, &h4, &p1, &p2) != 6) {
        return -1;
    }

    // Build host and port
    char host[20];
    snprintf(host, sizeof(host), "%d.%d.%d.%d", h1, h2, h3, h4);
    uint16_t port = (p1 << 8) | p2;

    // Create a split_t structure for the data connection
    split_t data_split;
    memset(&data_split, 0, sizeof(data_split));
    data_split.proto = URN_PROTO_TCP;
    data_split.port = port;
    data_split.parts[URN_PART_HOST] = host;

    // Connect to data server
    *data_fd = hal_net_connect(&data_split);
    if (*data_fd < 0) {
        return -1;
    }

    return 0;
}

static int os_ftp_connect(int fd, split_t *urn)
{
    const char *login = *urn->parts[URN_PART_LOGIN] ? urn->parts[URN_PART_LOGIN] : "anonymous";
    const char *pass = *urn->parts[URN_PART_PASS] ? urn->parts[URN_PART_PASS] : "pat@frites.be";

    char line[256];
    char cmd[256];
    int code;

    // Read initial FTP response (expect 220)
    if (os_ftp_read_response(fd, line, sizeof(line), &code) < 0 || code != 220) {
        hal_net_disconnect(DB_FTP_SET, fd);
        g_ftp_fd = -1;
        return -1;
    }

    // Send USER command
    snprintf(cmd, sizeof(cmd), "USER %s\r\n", login);
    if (hal_net_send(fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        hal_net_disconnect(DB_FTP_SET, fd);
        g_ftp_fd = -1;
        return -1;
    }

    // Read USER response (expect 331 or 230)
    if (os_ftp_read_response(fd, line, sizeof(line), &code) < 0 || (code != 331 && code != 230)) {
        hal_net_disconnect(DB_FTP_SET, fd);
        g_ftp_fd = -1;
        return -1;
    }

    // If 230, already logged in without password
    if (code == 230)
        goto CWD;

    // Send PASS command
    snprintf(cmd, sizeof(cmd), "PASS %s\r\n", pass);
    if (hal_net_send(fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        hal_net_disconnect(DB_FTP_SET, fd);
        g_ftp_fd = -1;
        return -1;
    }

    // Read PASS response (expect 230)
    if (os_ftp_read_response(fd, line, sizeof(line), &code) < 0 || code != 230) {
        hal_net_disconnect(DB_FTP_SET, fd);
        g_ftp_fd = -1;
        return -1;
    }

CWD:
    // If path specified, change directory
    if (urn->parts[URN_PART_PATH] && *urn->parts[URN_PART_PATH]) {
        snprintf(cmd, sizeof(cmd), "CWD %s\r\n", urn->parts[URN_PART_PATH]);
        if (hal_net_send(fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
            hal_net_disconnect(DB_FTP_SET, fd);
            g_ftp_fd = -1;
            return -1;
        }

        // Read CWD response (expect 250)
        if (os_ftp_read_response(fd, line, sizeof(line), &code) < 0 || code != 250) {
            hal_net_disconnect(DB_FTP_SET, fd);
            g_ftp_fd = -1;
            return -1;
        }
    }

    // // Get features
    // snprintf(cmd, sizeof(cmd), "FEAT\r\n");
    // if (hal_net_send(fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
    //     // FEAT failure is not critical, continue anyway
    // } else {
    //     os_ftp_read_response(fd, line, sizeof(line), &code);
    //     // Read until 211 response ends
    //     while (os_ftp_read_response(fd, line, sizeof(line), &code) >= 0 && code != 211);
    // }

    return fd;
}

static int os_connect(uint8_t set, const char *name, const char *urn) {
    int fd = -1;

    if (set == DB_FTP_SET && g_ftp_fd >= 0) {
        hal_net_disconnect(set, g_ftp_fd);
        g_ftp_fd = -1;
    }

    // Get configuration if needed
    entry_t *entry = name ? bdb_entry_get(set, name) : 0;
    bool use_db = entry != 0 && urn == 0;
    urn = use_db ? string_cstr(entry->string) : urn;
    if (!urn)
        goto finalize;

    split_t *split = bdb_urn_split(urn);
    if (split->proto == 0)
        goto finalize;


    if (set == DB_MIN_SET) {
        g_proto = split->proto;
    }
    memset(&g_ws_state, 0, sizeof(g_ws_state));

    // Connect to the host
    fd = hal_net_connect(split);
    if (fd >= 0) {
        if (set == DB_MIN_SET) {
            if (g_proto == URN_PROTO_WS || g_proto == URN_PROTO_WSS) {
                fd = os_ws_connect(fd, split);
            }
            os_redir_print_string(P_ROULEAU_OFF);
        } else if (set == DB_FTP_SET) {
            fd = os_ftp_connect(fd, split);
            g_ftp_fd = fd;
            if (fd >= 0) {
                strncpy(g_ftp_connected_host, split->parts[URN_PART_HOST],
                        sizeof(g_ftp_connected_host) - 1);
                g_ftp_connected_host[sizeof(g_ftp_connected_host) - 1] = 0;
                if (!eval_running())
                    hal_print_string("OK\r\n");
            }
        }
    }

    if (!use_db && name && *name > 0) {
        bdb_entry_set(set, name, (char *)urn, true);
        os_db_save();
    }

finalize:
    return fd;
}

static void os_disconnect(uint8_t set) {
    if (set == DB_MIN_SET) {
        hal_net_disconnect(set, bmem->sock);
        bmem->sock = -1;
        os_redir_print_string("\r\n" MODE_INIT_STRING CON G0 INK7);
        if (!eval_running())
            hal_print_string("Ready\r\n");
    } else if (set == DB_FTP_SET) {
        hal_net_disconnect(set, g_ftp_fd);
        g_ftp_fd = -1;
        *g_ftp_connected_host = 0;
        if (!eval_running())
            hal_print_string("OK\r\n");
    }
}

static void os_cat(void) {
    os_redir_print_string("\r\nDrive: A\r\n\r\n");
    size_t total = hal_cat();
    os_redir_print_integer("\r\n%3uK free\r\n\r\n", total / 1024);
}

static bool os_ftp_cat(void) {
    if (g_ftp_fd < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }
    os_redir_print_string("\r\nDrive: ");
    os_redir_print_string(g_ftp_connected_host);
    os_redir_print_string("\r\n\r\n");

    ssize_t total = 0;
    char cmd[256];
    char line[256];
    int code;
    int data_fd = -1;

    // Open passive mode data connection
    if (os_ftp_open_passive(g_ftp_fd, &data_fd) < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Send LIST command
    snprintf(cmd, sizeof(cmd), "LIST\r\n");
    if (hal_net_send(g_ftp_fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        if (data_fd >= 0)
            hal_net_disconnect(DB_FTP_SET, data_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Read list response (expect 150)
    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || (code != 150 && code != 125)) {
        if (data_fd >= 0)
            hal_net_disconnect(DB_FTP_SET, data_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Read final response (expect 226 Transfer complete)
    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || code != 226) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Read list data line by line from data connection until transfer completes
    int line_idx = 0;
    uint64_t start_ms = hal_get_ms();
    bool transfer_complete = false;

    while ((hal_get_ms() - start_ms) < 1000 && !transfer_complete) {
        int n = hal_net_recv(data_fd, (uint8_t *)&line[line_idx], 1);

        if (n <= 0) {
            if (n < 0) {
                // Connection closed, expect 226 on control connection
                transfer_complete = true;
                break;
            }
            continue;
        }

        start_ms = hal_get_ms();
        char c = line[line_idx];

        if (c == '\n') {
            if (line_idx > 0 && line[line_idx - 1] == '\r')
                line_idx--;
            line[line_idx] = 0;

            if (line_idx > 0) {
                // This is a file listing line
                os_ftp_cat_file(line);
                total++;
            }

            line_idx = 0;
        } else if (c != '\r') {
            line_idx++;
            if (line_idx >= (int)sizeof(line) - 1)
                line_idx = 0; // Reset on overflow
        }
    }

    // Close data connection
    if (data_fd >= 0)
        hal_net_disconnect(DB_FTP_SET, data_fd);

    os_redir_print_integer("\r\n%3zd file(s)\r\n\r\n", total);

    return true;
}

static bool os_ftp_put_file(const char *filename)
{
    if (g_ftp_fd < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    char cmd[256];
    char line[256];
    int code;
    int data_fd = -1;

    // Get local file size
    int file_size = hal_get_file_size(filename);
    if (file_size <= 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Open local file for reading
    int local_fd = hal_open(filename, B_RDONLY);
    if (local_fd < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Set binary mode
    snprintf(cmd, sizeof(cmd), "TYPE I\r\n");
    if (hal_net_send(g_ftp_fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || code != 200) {
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Open passive mode data connection
    if (os_ftp_open_passive(g_ftp_fd, &data_fd) < 0) {
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Send STOR command
    snprintf(cmd, sizeof(cmd), "STOR %s\r\n", filename);
    if (hal_net_send(g_ftp_fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        if (data_fd >= 0)
            hal_net_disconnect(DB_FTP_SET, data_fd);
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Read STOR response (expect 150 or 125)
    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || (code != 150 && code != 125)) {
        if (data_fd >= 0)
            hal_net_disconnect(DB_FTP_SET, data_fd);
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Send file data through data connection
    uint8_t buffer[NET_BUFFER_MAX];
    ssize_t bytes_sent = 0;

    while (bytes_sent < file_size) {
        int to_read = file_size - bytes_sent;
        if (to_read > NET_BUFFER_MAX)
            to_read = NET_BUFFER_MAX;

        int n = hal_read(local_fd, buffer, to_read);
        if (n <= 0)
            break;

        // Send data through data connection
        if (hal_net_send(data_fd, buffer, n) < 0) {
            if (data_fd >= 0)
                hal_net_disconnect(DB_FTP_SET, data_fd);
            hal_close(local_fd);
            bmem->bstate.error = BERROR_SOCK;
            return false;
        }

        bytes_sent += n;
    }

    // Close data connection
    if (data_fd >= 0)
        hal_net_disconnect(DB_FTP_SET, data_fd);

    // Close local file
    hal_close(local_fd);

    // Read final response (expect 226 Transfer complete)
    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || code != 226) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    return bytes_sent == file_size;
}

static bool os_ftp_get_file(const char *filename)
{
    if (g_ftp_fd < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    char cmd[256];
    char line[256];
    int code;
    int data_fd = -1;

    // Get file size with SIZE command
    snprintf(cmd, sizeof(cmd), "SIZE %s\r\n", filename);
    if (hal_net_send(g_ftp_fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || code != 213) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    ssize_t file_size = strtol(line + 4, NULL, 10);
    if (file_size <= 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Open local file for writing
    int local_fd = hal_open(filename, B_CREAT | B_WRONLY);
    if (local_fd < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Set binary mode
    snprintf(cmd, sizeof(cmd), "TYPE I\r\n");
    if (hal_net_send(g_ftp_fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || code != 200) {
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Open passive mode data connection
    if (os_ftp_open_passive(g_ftp_fd, &data_fd) < 0) {
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Send RETR command
    snprintf(cmd, sizeof(cmd), "RETR %s\r\n", filename);
    if (hal_net_send(g_ftp_fd, (const uint8_t *)cmd, strlen(cmd)) < 0) {
        if (data_fd >= 0)
            hal_net_disconnect(DB_FTP_SET, data_fd);
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Read RETR response (expect 150 or 125)
    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || (code != 150 && code != 125)) {
        if (data_fd >= 0)
            hal_net_disconnect(DB_FTP_SET, data_fd);
        hal_close(local_fd);
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    // Read file data from data connection
    uint8_t buffer[NET_BUFFER_MAX];
    ssize_t bytes_read = 0;
    uint64_t start_ms = hal_get_ms();

    while (bytes_read < file_size && (hal_get_ms() - start_ms) < 30000) {
        int n = hal_net_recv(data_fd, buffer, sizeof(buffer));

        if (n <= 0) {
            if (n < 0)
                break;
            continue;
        }

        start_ms = hal_get_ms(); // Reset timeout on data received

        // Write to local file
        if (hal_write(local_fd, buffer, n) < 0) {
            if (data_fd >= 0)
                hal_net_disconnect(DB_FTP_SET, data_fd);
            hal_close(local_fd);
            bmem->bstate.error = BERROR_SOCK;
            return false;
        }

        bytes_read += n;
    }

    // Close data connection
    if (data_fd >= 0)
        hal_net_disconnect(DB_FTP_SET, data_fd);

    // Close local file
    hal_close(local_fd);

    // Read final response (expect 226 Transfer complete)
    if (os_ftp_read_response(g_ftp_fd, line, sizeof(line), &code) < 0 || code != 226) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    return bytes_read == file_size;
}

static bool os_ftp_files(uint8_t func, const char *filename)
{
    if (g_ftp_fd < 0)
        return false;

    if (func == TOKEN_KEYWORD_PUT)
        return os_ftp_put_file(filename);

    if (func == TOKEN_KEYWORD_GET)
        return os_ftp_get_file(filename);

    return false;
}

void os_cat_file(const char *filename, size_t size) {
    char buffer[40];
    char *ext = strrchr(filename, '.');
    int n = ext ? (ext - filename) : strlen(filename);
    ext = ext ? ext + 1 : "";
    snprintf(buffer, sizeof(buffer), "%-16.*s.%-4s %zu\r\n", n, filename, ext,
             size);
    os_redir_print_string(buffer);
}

/**
 * @brief Parse a printable string from src to dst
 *
 * This function copies printable characters from src to dst, skipping
 * non-printable characters. It returns a pointer to the first non-printable
 * character after the copied characters in src.
 *
 * @param dst Destination buffer for the printable string
 * @param dst_size Size of the destination buffer
 * @param src Source string to parse
 * @return Pointer to the first non-printable character in src after copying
 */
static char *parse_printable(char *dst, size_t dst_size, const char *src) {
    // Count of copied chars
    int32_t n = 0;
    // Jump over non printable chars from src
    while (*src && (*src <= 32))
        src++;
    // Copy printable chars from src to dst
    while (*src && dst_size > 1 && (*src > 32)) {
        *dst++ = *src++;
        dst_size--;
        n++;
    }
    // Null-terminate the string
    if (n > 0)
        *dst = '\0';
    // Return pointer to first non printable char after copied chars
    while (*src && (*src > 32))
        src++;
    return (char *)src;
}

void os_ftp_cat_file(const char *line) {
    char part[32];
    const char *src = line;
    int32_t n = 0;
    size_t size = 0;
    while (*src) {
        src = parse_printable(part, sizeof(part), src);
        n++;
        if (n == 5)
            size = strtoul(part, 0, 10);
    }
    os_cat_file(part, size);
}

#define FILE_EXT_BAS ".bas"
#define FILE_EXT_BST ".bst"
#define FILE_EXT_VAR ".var"

static char *os_filename(const char *name, int16_t *type) {
    static const char *g_files_exts[4] = {
        FILE_EXT_BAS,
        FILE_EXT_BST,
        FILE_EXT_VAR,
        0,
    };

    static char filename[FILE_NAME_SIZE];

    const char *dst_ext = FILE_EXT_BAS;
    *type = 0;
    char *src_ext = strrchr(name, '.');
    uint16_t len = src_ext ? src_ext - name : strlen(name);
    len = len > FILE_BASE_MAX ? FILE_BASE_MAX : len;

    if (src_ext) {
        dst_ext = 0;
        for (const char **i_ext = g_files_exts; *i_ext; i_ext++) {
            if (strcasecmp(*i_ext, src_ext) == 0) {
                dst_ext = *i_ext;
                break;
            }
            (*type)++;
        }
        // Invalid source extension
        if (!dst_ext) {
            *type = -1;
            return 0;
        }
    }

    strncpy(filename, name, len);
    filename[len] = 0;
    strcat(filename, dst_ext);

    return filename;
}

static int os_net_send(int fd, const uint8_t *buffer, size_t size) {
    if (g_proto != URN_PROTO_WS && g_proto != URN_PROTO_WSS)
        return hal_net_send(fd, buffer, size);

    if (size == 0)
        return 0;

    // Build WebSocket frame
    // Frame format: FIN(1) RSV(3) OPCODE(4) | MASK(1) PAYLOAD_LEN(7) | [extended payload length] | [masking key] | [payload]
    uint8_t ws_frame[NET_BUFFER_MAX + 14]; // Header + key + payload
    uint8_t *dst = ws_frame;

    // Byte 0: FIN=1, RSV=0, OPCODE=1 (text frame)
    *dst++ = 0x81;

    // Get a simple mask key (in practice should be random)
    static uint32_t mask_seed = 0x12345678;
    mask_seed = (mask_seed * 1103515245 + 12345) & 0x7fffffff;
    uint8_t mask_key[4];
    mask_key[0] = (mask_seed >> 0) & 0xFF;
    mask_key[1] = (mask_seed >> 8) & 0xFF;
    mask_key[2] = (mask_seed >> 16) & 0xFF;
    mask_key[3] = (mask_seed >> 24) & 0xFF;

    // Byte 1: MASK=1, PAYLOAD_LEN or extended length indicator
    if (size < 126) {
        *dst++ = 0x80 | size; // MASK=1, length in 7 bits
    } else if (size < 65536) {
        *dst++ = 0xFE; // MASK=1, 16-bit extended length
        *dst++ = (size >> 8) & 0xFF;
        *dst++ = size & 0xFF;
    } else {
        return -1; // 64-bit length not supported
    }

    // Masking key (4 bytes)
    *dst++ = mask_key[0];
    *dst++ = mask_key[1];
    *dst++ = mask_key[2];
    *dst++ = mask_key[3];

    // Payload (masked)
    for (size_t i = 0; i < size; i++) {
        *dst++ = buffer[i] ^ mask_key[i % 4];
    }

    size_t frame_size = dst - ws_frame;
    return hal_net_send(fd, ws_frame, frame_size);
}

static int os_net_send_pong(int fd, const uint8_t *payload, size_t size) {
    if (size > 125) {
        // Pong control frames must be <= 125 bytes
        return -1;
    }

    // Build WebSocket pong frame
    uint8_t ws_frame[14 + 125]; // Header + key + max payload
    uint8_t *dst = ws_frame;

    // Byte 0: FIN=1, RSV=0, OPCODE=10 (pong frame)
    *dst++ = 0x8A;

    // Get a simple mask key
    static uint32_t pong_seed = 0x87654321;
    pong_seed = (pong_seed * 1103515245 + 12345) & 0x7fffffff;
    uint8_t mask_key[4];
    mask_key[0] = (pong_seed >> 0) & 0xFF;
    mask_key[1] = (pong_seed >> 8) & 0xFF;
    mask_key[2] = (pong_seed >> 16) & 0xFF;
    mask_key[3] = (pong_seed >> 24) & 0xFF;

    // Byte 1: MASK=1, PAYLOAD_LEN (always < 126 for control frames)
    *dst++ = 0x80 | size;

    // Masking key (4 bytes)
    *dst++ = mask_key[0];
    *dst++ = mask_key[1];
    *dst++ = mask_key[2];
    *dst++ = mask_key[3];

    // Payload (masked)
    for (size_t i = 0; i < size; i++) {
        *dst++ = payload[i] ^ mask_key[i % 4];
    }

    size_t frame_size = dst - ws_frame;
    return hal_net_send(fd, ws_frame, frame_size);
}

static int os_net_receive(int fd, uint8_t *buffer, size_t size) {
    if (g_proto != URN_PROTO_WS && g_proto != URN_PROTO_WSS)
        return hal_net_recv(fd, buffer, size);

    if (size == 0)
        return 0;

    static uint8_t ws_header[2];
    static uint8_t ws_ext_length[2];
    static uint16_t ws_length;
    static uint8_t ws_opcode;
    static uint8_t ws_mask;

    if (g_ws_state.state == WS_STATE_READ_HEADER0) {
        int n = hal_net_recv(fd, ws_header + g_ws_state.read, 2 - g_ws_state.read);
        if (n <= 0)
            return n;
        g_ws_state.read += n;
        if (g_ws_state.read < 2)
            return 0;

        g_ws_state.read = 0;
        ws_length = ws_header[1] & 0x7f;
        ws_opcode = ws_header[0] & 0x0f;
        ws_mask = (ws_header[1] & 0x80) != 0;
        g_ws_state.fin = (ws_header[0] & 0x80) != 0;

        // Handle invalid length (127 = 64-bit not supported)
        if (ws_length == 127)
            return -1;

        if (ws_length == 0)
            return 0;

        if (ws_length == 126) {
            // 16-bit extended payload length
            g_ws_state.state = WS_STATE_READ_EXT_LEN0;
        } else {
            // Payload length in header, or go to mask key if masked
            g_ws_state.payload_remain = ws_length;
            if (ws_mask) {
                g_ws_state.state = WS_STATE_READ_MASK_KEY;
            } else {
                g_ws_state.state = WS_STATE_READ_PAYLOAD;
            }
        }
        return 0;
    }

    if (g_ws_state.state == WS_STATE_READ_EXT_LEN0) {
        int n = hal_net_recv(fd, ws_ext_length + g_ws_state.read, 2 - g_ws_state.read);
        if (n <= 0)
            return n;
        g_ws_state.read += n;
        if (g_ws_state.read < 2)
            return 0;

        // Convert extended length from network byte order (big-endian)
        ws_length = ((uint16_t)ws_ext_length[0] << 8) | ws_ext_length[1];
        g_ws_state.payload_remain = ws_length;
        g_ws_state.read = 0;

        if (ws_mask) {
            g_ws_state.state = WS_STATE_READ_MASK_KEY;
        } else {
            g_ws_state.state = WS_STATE_READ_PAYLOAD;
        }
        return 0;
    }

    if (g_ws_state.state == WS_STATE_READ_MASK_KEY) {
        int n = hal_net_recv(fd, g_ws_state.mask_key + g_ws_state.read, 4 - g_ws_state.read);
        if (n <= 0)
            return n;
        g_ws_state.read += n;
        if (g_ws_state.read < 4)
            return 0;

        g_ws_state.read = 0;
        g_ws_state.state = WS_STATE_READ_PAYLOAD;
        return 0;
    }

    if (g_ws_state.state == WS_STATE_READ_PAYLOAD) {
        if (g_ws_state.payload_remain == 0) {
            g_ws_state.state = WS_STATE_READ_HEADER0;
            return 0;
        }

        int read_size = size > g_ws_state.payload_remain ? g_ws_state.payload_remain : size;
        int n = hal_net_recv(fd, buffer, read_size);
        if (n <= 0)
            return n;

        // Unmask the payload if needed
        if (ws_mask) {
            for (int i = 0; i < n; i++) {
                buffer[i] ^= g_ws_state.mask_key[(g_ws_state.read + i) % 4];
            }
        }

        g_ws_state.read += n;
        g_ws_state.payload_remain -= n;

        if (g_ws_state.payload_remain == 0) {
            g_ws_state.read = 0;
            g_ws_state.state = WS_STATE_READ_HEADER0;
        }

        // Handle control frames (always returned immediately)
        if (ws_opcode == 0x8) {
            // Close frame
            return -1;
        }
        if (ws_opcode == 0x9) {
            // Ping frame - store payload and respond with pong
            g_ws_state.ping_size = n > 125 ? 125 : n;
            if (g_ws_state.ping_size > 0) {
                for (int i = 0; i < g_ws_state.ping_size; i++) {
                    g_ws_state.ping_payload[i] = buffer[i];
                }
            }
            os_net_send_pong(fd, g_ws_state.ping_payload, g_ws_state.ping_size);
            return 0;
        }
        if (ws_opcode == 0xA) {
            // Pong frame - skip them
            return 0;
        }

        // Handle data frames (0x1=text, 0x2=binary, 0x0=continuation)
        if (ws_opcode == 0x0) {
            // Continuation frame
            if (!g_ws_state.fin) {
                // More frames coming, skip this data
                return 0;
            } else {
                // Final continuation frame, return data
                g_ws_state.fragmented = 0;
                return n;
            }
        }

        if (ws_opcode == 0x01 || ws_opcode == 0x02) {
            // Data frame (text or binary)
            if (!g_ws_state.fin) {
                // Start of fragmented message, skip data for now
                g_ws_state.fragmented = 1;
                return 0;
            } else {
                // Complete frame, return data
                g_ws_state.fragmented = 0;
                return n;
            }
        }

        // Unknown opcode
        return 0;
    }

    return 0;
}

static void os_loop_connected() {
    uint8_t buffer[NET_BUFFER_MAX];
    static uint8_t ESC_count = 0;
    static uint8_t pending_key = 0;

    // Read data on socket in a non blocking mode
    int ret = os_net_receive(bmem->sock, buffer, sizeof(buffer));
    if (ret < 0) {
        // If error on socket: exit the connected mode
        ESC_count = 0;
        pending_key = 0;
        os_disconnect(DB_MIN_SET);
        return;
    } else if (ret > 0) {
        // If chars on socket: forward chars to screen (print)
        hal_print_buffer(buffer, ret);
    }

    uint8_t key = hal_get_key();
    // If keyboard has not char: return
    if (key == 0)
        return;

    // Handle SEP and SS2 keys specially: store and wait for next key
    if (key == SEP || key == SS2) {
        pending_key = key;
        ESC_count = 0;
        return;
    }

    // If we have a pending special key, send both together
    if (pending_key) {
        uint8_t keys[2] = {pending_key, key};
        ret = os_net_send(bmem->sock, keys, 2);
        pending_key = 0;
    } else {
        // Send char to server through the socket
        ret = os_net_send(bmem->sock, &key, 1);
    }

    if (ret < 0) {
        // If error on socket: exit the connected mode
        ESC_count = 0;
        pending_key = 0;
        os_disconnect(DB_MIN_SET);
        return;
    }

    if (key == '\x1b') {
        ESC_count++;
        if (ESC_count >= 2) {
            // If 2 ESC pressed: exit the connected mode
            ESC_count = 0;
            pending_key = 0;
            os_disconnect(DB_MIN_SET);
        }
    } else {
        ESC_count = 0;
    }
}

static void os_loop_basic() {
    int fn = hal_get_function_key();
    if (fn == 1) {
        bmem->bstate.reset = 1;
        bdb_entry_set(DB_CONFIG_SET, "autoexec", "1", true);
        os_db_save();
    } else if (fn > 1) {
        bmem->bstate.reset = 1;
        bdb_entry_set(DB_CONFIG_SET, "autoexec", "0", true);
        os_db_save();
    } else {
        char key = os_get_key();
        bastos_send_keys((char *)&key, key != 0 ? 1 : 0, true);
        bastos_loop();
    }
    if (bastos_is_reset()) {
        bastos_done();
        hal_reset();
    }
}

void os_loop() {
    if (bmem->sock >= 0) {
        os_loop_connected();
    } else {
        os_loop_basic();
    }
}

bool os_debug(void) {
    if (!bmem)
        return false;
    return bmem->bstate.debug != 0;
}

void os_setup(void) {
    // Init Basic and display BASTOS banner
    bastos_init();
}
