#include "bio.h"
#include "os.h"

#ifdef MINITEL
#include "tty-minitel.h"
#else
#include "tty-vt100.h"
#endif

#define BASTOS_NETWORK_COUNT (100)
#define BASTOS_KNOWN_NETWORK_COUNT (10)

typedef struct network_list_s
{
    int16_t first;
    int16_t last;
    int16_t count;
} network_list_t;

// OS variables
int16_t g_net_count = 0;
network_t *g_nets[BASTOS_NETWORK_COUNT] = {0};

// List of known networks
network_list_t g_known_nets = {
    .first = -1,
    .last = -1,
    .count = 0,
};

// List of available networks
network_list_t g_available_nets = {
    .first = -1,
    .last = -1,
    .count = 0,
};

static network_t *wifi_new_network(const network_t *net)
{
    if (g_net_count >= BASTOS_NETWORK_COUNT)
        return NULL;

    network_t *new_net = (network_t *)malloc(sizeof(network_t));
    if (!new_net)
        return NULL;

    // Add to the networks store
    g_nets[g_net_count++] = new_net;

    *new_net = *net; // Copy the network data

    // Initialize the new network's links
    new_net->prev = -1;
    new_net->next = -1;

    return new_net;
}

static void wifi_add_network(const network_t *net, network_list_t *nets)
{
    network_t *new_net = wifi_new_network(net);
    if (!new_net)
        return;

    // Add to the networks list
    if (nets->first == -1)
    {
        // First network in the list
        nets->first = g_net_count - 1;
        nets->last = g_net_count - 1;
    }
    else
    {
        // Add to the end of the list
        int16_t last_index = nets->last;
        new_net->prev = last_index;
        new_net->next = -1;
        g_nets[last_index]->next = g_net_count - 1;
        nets->last = g_net_count - 1;
    }
    // Increment the count of networks
    nets->count++;
}

static void wifi_remove_networks(network_list_t *nets)
{
    // Parse through the networks and free them
    int16_t current = nets->first;
    while (current != -1)
    {
        network_t *net = g_nets[current];
        g_nets[current] = NULL;
        current = net->next;
        free(net);
    }
    // Reset the networks list
    nets->first = -1;
    nets->last = -1;
    g_net_count -= nets->count;
    nets->count = 0;
}

network_t *os_wifi_get_network_by_ssid(const char *ssid)
{
    for (int i = 0; i < g_net_count; i++)
        if (g_nets[i] && strcmp(g_nets[i]->ssid, ssid) == 0)
            return g_nets[i];
    return NULL;
}

network_t *os_wifi_get_network_by_id(int16_t id)
{
    int16_t n = 0;
    for (int16_t i = 0; i < g_net_count; i++)
    {
        network_t *net = g_nets[i];
        if (net->dBm != -128)
        {
            n++;
            if (n == id)
            {
                return net; // Return the network with the given ID
            }
        }
    }
    return NULL; // Network with the given ID not found
}

static void wifi_print_network(int n, const network_t *net)
{
    hal_print_integer("%2d ", n);
    hal_print_integer("%3d ", net->dBm);
    hal_print_string(net->ssid);
    hal_print_string("\r\n");
}

void os_wifi_list_networks(void)
{
    hal_print_string("\r\n" INV "ID dBm SSID" CLEOL " " NORMAL "\r\n");

    // Parse all newtorks and print those with dBm != -128
    int n = 0;
    for (int16_t i = 0; i < g_net_count; i++)
    {
        network_t *net = g_nets[i];
        if (net->dBm != -128)
        {
            wifi_print_network(++n, net);
        }
    }
    hal_print_integer(INV "%d network(s)" CLEOL NORMAL "\r\n\r\nReady\r\n", n);
}

void os_wifi_clear_networks(void)
{
    // Remove available networks and adjust g_net_count
    wifi_remove_networks(&g_available_nets);
    // Set dBm of known networks to -128
    for (int16_t i = g_known_nets.first; i != -1; i = g_nets[i]->next)
    {
        g_nets[i]->dBm = -128;
    }
}

void os_wifi_add_network(const char *ssid, uint8_t encryption, int32_t rssi)
{
    // Check if the network already exists
    network_t *existing_net = os_wifi_get_network_by_ssid(ssid);
    if (existing_net)
    {
        // Update existing network
        existing_net->encryption = encryption;
        existing_net->dBm = rssi;
        return;
    }
    // Create a new network entry
    network_t new_net = {
        .dBm = rssi,
        .encryption = encryption,
        .count = 0, // Initial count of connections
    };
    strncpy(new_net.ssid, ssid, sizeof(new_net.ssid) - 1);
    new_net.ssid[sizeof(new_net.ssid) - 1] = '\0'; // Ensure null-termination
    // Add the new network to the available networks list
    wifi_add_network(&new_net, &g_available_nets);
}

int os_wifi_connect(network_t *net)
{
    hal_print_string(LINE0 INV BLINK "Connecting ");
    hal_print_string(net->ssid);
    hal_print_string(CLEOL NORMAL "\n");

    int ret = hal_wifi_connect(net->ssid, net->secret);
    if (ret != 0)
    {
        // Ask secret
        const char *secret = "changeme";
        // Connect again with new secret
        ret = hal_wifi_connect(net->ssid, secret);
        // if connected => move network to known network and save OS variables
        if (ret == 0)
        {
            strncpy(net->secret, secret, sizeof(net->secret));
        }
    }

    if (ret != 0)
    {
        hal_print_string(LINE0 INV "Failed to connect" CLEOL NORMAL "\n");
    }
    else
    {
        hal_print_string(LINE0 INV "Connected" CLEOL NORMAL "\n");
    }


    return ret;
}

uint8_t os_get_key()
{
    static bool fkey = false;
    uint8_t key = hal_get_key();

    if (key == 0)
        return 0; // No key pressed

    if (key == 0x13)
    {
        // Function key pressed
        fkey = true;
        key = 0;
    }
    else
    {
        if (fkey)
        {
            if (key == 0x47)
            {               // CORRECTION key
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x45)
            {            // ANNULATION key
                key = 3; // Convert to Ctrl+C
            }
            else
            {               // ENVOI and other function keys
                key = '\r'; // Convert to Enter
            }
            fkey = false;
        }
        else
        {
            if (key == 0x08)
            {
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x1b)
            {
                key = 3; // Convert ESC to Ctrl+C
            }
        }
    }
    return key;
}

void os_bootstrap(void)
{
    // Remove all networks
    wifi_remove_networks(&g_available_nets);
    wifi_remove_networks(&g_known_nets);

    // Load config
    int fd = hal_open("$$$CONFIG$$$", B_RDONLY);
    if (fd >= 0)
    {
        network_t net;
        while (hal_read(fd, &net, sizeof(network_t)) == sizeof(network_t))
        {
            net.dBm = -128;
            wifi_add_network(&net, &g_known_nets);
        }
        hal_close(fd);
    }

    // Init Basic and display BASTOS banner
    bastos_init();
    bastos_send_keys("bastos\n", 7, false);
}
