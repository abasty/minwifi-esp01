#include "bdb.h"
#include "bio.h"
#include "bmemory.h"
#include "os-private.h"
#include "os.h"

#ifdef MINITEL
#include "tty-minitel.h"
#else
#include "tty-vt100.h"
#endif

#define AUTOEXEC_FILE "autoexec.bas"
#define AUTOLOAD_DB_FILE "autoload.db"

// OS WiFi variables
// FIXME (Move to Basic memory)
char g_wifi_connected_ssid[20] = ""; // 20 first characters of SSID
char g_wifi_connected_ip[16] = "";
char g_ftp_connected_host[32] = "";

static void os_set_redirect(int fd) { bmem->bstate.output_fd = fd; }

static int os_concat_buffer(const char *name, const char *buffer, int n) {
    var_t *var = bmem_var_get(name);
    if (!var || n == 0)
        return 0;

    int l = string_len(var->string);
    char *value = bmem_string_alloc(l + n);

    char *dst = value + 2;
    const char *src = string_cstr(var->string);
    int i = l;
    while (i > 0) {
        *dst++ = *src++;
        i--;
    }
    src = buffer;
    i = n;
    while (i > 0) {
        *dst++ = *src++;
        i--;
    }
    *dst = 0;

    bmem_var_string_set(name, value, false);
    return n;
}

static int os_redir_print_buffer(const char *buffer, int n) {
    // Redir to fd
    if (bmem->bstate.output_fd >= 0)
        return hal_write(bmem->bstate.output_fd, buffer, n);

    // Redir to var
    if (*bmem->bstate.output_var != 0)
        return os_concat_buffer(bmem->bstate.output_var, buffer, n);

    return hal_print_buffer((uint8_t *) buffer, n);
}

static int os_redir_print_string(const char *s) {
    if (bmem->bstate.output_fd >= 0 || *bmem->bstate.output_var != 0)
        return os_redir_print_buffer(s, strlen(s));

    return hal_print_string(s);
}

static int os_redir_print_integer(const char *format, int i) {
    if (bmem->bstate.output_fd >= 0 || *bmem->bstate.output_var != 0) {
        char buffer[80];
        int len = snprintf(buffer, sizeof(buffer), format, i);
        return os_redir_print_buffer(buffer, len);
    }
    return hal_print_integer(format, i);
}

static int os_redir_print_float(float f) {
    if (bmem->bstate.output_fd >= 0 || *bmem->bstate.output_var != 0) {
        char buffer[16];
        int len = snprintf(buffer, sizeof(buffer), "%g", f);
        return os_redir_print_buffer(buffer, len);
    }
    return hal_print_float(f);
}

static void os_db_save(void) {
    int fd = hal_open(AUTOLOAD_DB_FILE, B_CREAT | B_WRONLY);
    if (fd < 0)
        return;

    // Write DB size
    uint16_t db_size = bmem->db_end - bmem->db_start;
    if (hal_write(fd, &db_size, sizeof(db_size)) < 0) {
        goto err;
    }

    // Write DB
    if (hal_write(fd, bmem->db_start, db_size) < 0) {
        goto err;
    }

err:
    if (fd >= 0) {
        hal_close(fd);
    }
}

static void os_db_load(void) {
    // Remove memory records
    bmem_db_clear();

    int fd = hal_open(AUTOLOAD_DB_FILE, B_RDONLY);
    if (fd < 0)
        return;

    // Read DB size
    int16_t db_size;
    if (hal_read(fd, &db_size, sizeof(db_size)) != sizeof(db_size))
        goto finalize;

    // Check DB size
    if (db_size > BASTOS_DB_SIZE)
        goto finalize;

    // Read DB records from mass storage
    bmem->db_start = bmem->db_end - db_size;
    hal_read(fd, bmem->db_start, db_size);

finalize:
    hal_close(fd);
}

static void os_autoexec(void) {
    hal_print_string(MODE_INIT_STRING);
    if (bastos_load(AUTOEXEC_FILE) == BERROR_NONE) {
        running_state_clear();
        bmem->bstate.pc = bmem_prog_first_line();
        bmem->bstate.running = bmem->bstate.pc != 0;
    } else {
        bastos_send_keys("bastos\n", 7, false);
    }
}

/**
 * @brief Print network and add it to SSID array
 *
 * @param i Index of the network in the list
 * @param ssid SSID of the network
 * @param encryption Encryption type (0: None, 1: WEP, 2: WPA, 3: WPA2)
 * @param rssi Signal strength in dBm
 */
void os_wifi_print_network(int i, const char *ssid, uint8_t encryption,
                           int32_t rssi) {

    // Print the list of networks
    os_redir_print_integer("%2d ", i);
    os_redir_print_integer("%3d ", rssi);
    os_redir_print_string(ssid);
    os_redir_print_string("\r\n");

    // Add the network to the SSID array (SSID$(i))
    // Note: If i does not exist in the array, cstr is 0 and the SSID is not
    // added to the array
    uint16_t len = WIFI_SSID_MAX_SIZE;
    char *cstr = bmem_ssid_get_from_id(i);
    if (cstr) {
        strncpy(cstr, ssid, len - 1);
        cstr[len - 1] = '\0';
    }
}

static void os_wifi_scan(void) {
    // Display scanning status
    os_redir_print_string(LINE0 INV BLINK "Scanning..." CLEOL NORMAL "\n");

    // Scan and display Wi-Fi networks
    bmem_ssid_array_new();
    os_redir_print_string("\r\n" INV "ID dBm SSID" CLEOL " " NORMAL "\r\n");
    int n = hal_wifi_scan();

    os_redir_print_integer(
        "\r\n%d network(s)" CLEOL NORMAL "\r\n\r\n" LINE0 CLEOL "\n", n);
}

static int os_wifi_connect(const char *ssid) {
    bool use_db = false;
    char secret[WIFI_SECRET_MAX_SIZE] = "";

    entry_t *entry = bdb_entry_get(DB_WIFI_SET, ssid);
    if (entry) {
        strncpy(secret, string_cstr(entry->string), WIFI_SECRET_MAX_SIZE - 1);
        secret[WIFI_SECRET_MAX_SIZE - 1] = 0;
        use_db = true;
    }

    if (!use_db) {
        os_redir_print_string(LINE0 INV "Password: " CLEOL);
        if (os_get_string(secret, sizeof(secret), '*') < 0) {
            os_redir_print_string(LINE0 CLEOL "\r\n");
            return -1;
        }
    }
    os_redir_print_string(LINE0 INV BLINK "Connecting to ");
    os_redir_print_string(ssid);
    os_redir_print_string(CLEOL NORMAL "\n");

    int ret = hal_wifi_connect(ssid, secret);
    if (ret == 0) {
        if (!eval_running()) {
            os_redir_print_string("OK\r\n");
        }
        if (!use_db) {
            bdb_entry_set(DB_WIFI_SET, ssid, secret, true);
            os_db_save();
        }
    }

#ifdef MINITEL
    os_redir_print_string(LINE0 CLEOL "\r\n");
#endif
    return ret;
}

static int os_wifi_erase(const char *ssid) {
    bdb_entry_set(DB_WIFI_SET, ssid, 0, true);
    os_db_save();
    return 0;
}

void os_wifi_set_info(const char *ssid, const char *ip) {
    if (ssid) {
        strncpy(g_wifi_connected_ssid, ssid, sizeof(g_wifi_connected_ssid) - 1);
        g_wifi_connected_ssid[sizeof(g_wifi_connected_ssid) - 1] = '\0';
    }
    if (ip) {
        strncpy(g_wifi_connected_ip, ip, sizeof(g_wifi_connected_ip) - 1);
        g_wifi_connected_ip[sizeof(g_wifi_connected_ip) - 1] = '\0';
    }
}

static void os_wifi_status(void) {
    os_redir_print_string("\r\n" INV "IP              SSID" CLEOL " " NORMAL
                          "\r\n");
    if (!hal_wifi_is_connected()) {
        os_redir_print_string("Not connected");
    } else {
        os_redir_print_string(g_wifi_connected_ip);
        uint8_t len = strlen(g_wifi_connected_ip);
        for (int i = 16 - len; i > 0; i--)
            os_redir_print_string(" ");
        os_redir_print_string(g_wifi_connected_ssid);
    }
    os_redir_print_string("\r\n\r\n");
}

static void os_ftp_status(void) {
    os_redir_print_string("\r\n" INV "FTP Host" CLEOL " " NORMAL "\r\n");

    // Check connection status
    if (*g_ftp_connected_host != 0 && !hal_ftp_is_connected()) {
        *g_ftp_connected_host = 0;
    }

    // Display connection status message
    if (*g_ftp_connected_host == 0) {
        os_redir_print_string("Not connected");
    } else {
        os_redir_print_string(g_ftp_connected_host);
    }
    os_redir_print_string("\r\n\r\n");
}

static void os_db_list(uint8_t set) {
    if (set != DB_WIFI_SET)
        os_redir_print_string("\r\n" INV "Key      Value" CLEOL " " NORMAL
                              "\r\n");
    else
        os_redir_print_string("\r\n" INV "SSID" CLEOL " " NORMAL "\r\n");

    int n = 0;
    entry_t *entry = bdb_entry_first();
    while (entry) {
        if (entry->token == set) {
            char line[40];
            if (set != DB_WIFI_SET)
                snprintf(line, 40, "%-8.8s %s", entry->bytes + entry->name_ofs,
                         string_cstr(entry->string));
            else
                snprintf(line, 40, "%s", entry->bytes + entry->name_ofs);
            line[39] = 0;
            os_redir_print_string(line);
            os_redir_print_string("\r\n");
            n++;
        }
        entry = bdb_entry_next(entry);
    }
    os_redir_print_integer(
        "\r\n%d record(s)" CLEOL NORMAL "\r\n\r\n" LINE0 CLEOL "\n", n);
}

static void os_db_erase(uint8_t set, const char *name) {
    entry_t *entry = bdb_entry_get(set, name);
    if (entry) {
        bdb_entry_unset(entry);
        os_db_save();
    }
}

static int os_get_string(char *buf, int size, char secret_char) {
    int i = 0;
    while (i < size - 1) {
        uint8_t key = os_get_key();
        if (key == 0) // No key pressed
            continue;
        if (key == 0x1b) // ESC
        {
            return -1; // Cancel the input
        }
        if (key == 0x7F) // DEL key
        {
            // FIXME: Use del_last_key()
            if (i > 0) {
                i--;
                os_redir_print_string("\b \b"); // Erase last character
            }
            continue;
        }
        // FIXME: Manage "Annulation", and use del_last_key()
        if (key == '\r' || key == '\n') // Enter key
        {
            break;
        }
        if (key >= 32 && key <= 126) // Printable characters
        {
            buf[i++] = key;
            const char key_str[2] = {secret_char ? secret_char : key, '\0'};
            os_redir_print_string(key_str);
        }
    }
    buf[i] = '\0'; // Null-terminate the string
    return i;      // Return the number of characters read
}

static uint8_t os_get_key() {
    static bool fkey = false;
    uint8_t key = hal_get_key();

    // If key == Ox1b then do what must be done

    if (key == 0)
        return 0; // No key pressed

    if (key == 0x13) {
        // Function key pressed
        fkey = true;
        key = 0;
    } else {
        if (fkey) {
            if (key == 0x47) {                     // CORRECTION key
                key = 0x7F;                        // Convert backspace to DEL
            } else if (key == 0x45) {              // ANNULATION key
                key = 1;                           // Convert to Ctrl+A
            } else if (key == 0x59) {              // CX/FIN key
                key = 0;                           // Ignore it
                os_redir_print_string("\x13\x59"); // Send CX/Fin to terminal
            } else {        // ENVOI and other function keys
                key = '\r'; // Convert to Enter
            }
            fkey = false;
        } else {
            if (key == 0x08) {
                key = 0x7F; // Convert backspace to DEL
            }
        }
    }
    return key;
}

static int os_connect(uint8_t set, const char *name, const char *urn) {
    int ret = -1;

    // Get configuration if needed
    entry_t *entry = name ? bdb_entry_get(set, name) : 0;
    bool use_db = entry != 0 && urn == 0;
    urn = use_db ? string_cstr(entry->string) : urn;
    if (!urn)
        goto finalize;

    split_t *split = bdb_urn_split(urn);
    if (split->proto == 0)
        goto finalize;

    // Connect to the host
    ret = hal_net_connect(split);
    if (ret >= 0) {
        if (set == DB_MIN_SET) {
            os_redir_print_string(P_ROULEAU_OFF);
        } else {
            if (set == DB_FTP_SET) {
                strncpy(g_ftp_connected_host, split->parts[URN_PART_HOST],
                        sizeof(g_ftp_connected_host) - 1);
                g_ftp_connected_host[sizeof(g_ftp_connected_host) - 1] = 0;
            }
            if (!eval_running()) {
                os_redir_print_string("OK\r\n");
            }
        }
    }

    if (!use_db && name && *name > 0) {
        bdb_entry_set(set, name, (char *)urn, true);
        os_db_save();
    }

finalize:
    return ret;
}

static void os_disconnect(uint8_t set) {
    if (set == DB_MIN_SET) {
        hal_net_disconnect(set, bmem->bstate.sock);
        bmem->bstate.sock = -1;
        os_redir_print_string("\r\n" MODE_INIT_STRING CON G0 INK7);
    } else if (set == DB_FTP_SET) {
        hal_net_disconnect(set, -1);
        *g_ftp_connected_host = 0;
    }

    if (!eval_running())
        os_redir_print_string("Ready\r\n");
}

static void os_cat(void) {
    os_redir_print_string("\r\nDrive: A\r\n\r\n");
    size_t total = hal_cat();
    os_redir_print_integer("\r\n%3uK free\r\n\r\n", total / 1024);
}

static bool os_ftp_cat(void) {
    if (!hal_ftp_is_connected()) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }
    os_redir_print_string("\r\nDrive: ");
    os_redir_print_string(g_ftp_connected_host);
    os_redir_print_string("\r\n\r\n");

    ssize_t total = hal_ftp_cat();
    if (total < 0) {
        bmem->bstate.error = BERROR_SOCK;
        return false;
    }

    os_redir_print_integer("\r\n%3zd file(s)\r\n\r\n", total);

    return true;
}

void os_cat_file(const char *filename, size_t size) {
    char buffer[40];
    char *ext = strrchr(filename, '.');
    int n = ext ? (ext - filename) : strlen(filename);
    ext = ext ? ext + 1 : "";
    snprintf(buffer, sizeof(buffer), "%-16.*s.%-4s %zu\r\n", n, filename, ext,
             size);
    os_redir_print_string(buffer);
}

/**
 * @brief Parse a printable string from src to dst
 *
 * This function copies printable characters from src to dst, skipping
 * non-printable characters. It returns a pointer to the first non-printable
 * character after the copied characters in src.
 *
 * @param dst Destination buffer for the printable string
 * @param dst_size Size of the destination buffer
 * @param src Source string to parse
 * @return Pointer to the first non-printable character in src after copying
 */
static char *parse_printable(char *dst, size_t dst_size, const char *src) {
    // Count of copied chars
    int32_t n = 0;
    // Jump over non printable chars from src
    while (*src && (*src <= 32))
        src++;
    // Copy printable chars from src to dst
    while (*src && dst_size > 1 && (*src > 32)) {
        *dst++ = *src++;
        dst_size--;
        n++;
    }
    // Null-terminate the string
    if (n > 0)
        *dst = '\0';
    // Return pointer to first non printable char after copied chars
    while (*src && (*src > 32))
        src++;
    return (char *)src;
}

void os_ftp_cat_file(const char *line) {
    char part[32];
    const char *src = line;
    int32_t n = 0;
    size_t size = 0;
    while (*src) {
        src = parse_printable(part, sizeof(part), src);
        n++;
        if (n == 5)
            size = strtoul(part, 0, 10);
    }
    os_cat_file(part, size);
}

#define FILE_EXT_BAS ".bas"
#define FILE_EXT_BST ".bst"
#define FILE_EXT_VAR ".var"

static char *os_filename(const char *name, int16_t *type) {
    static const char *g_files_exts[4] = {
        FILE_EXT_BAS,
        FILE_EXT_BST,
        FILE_EXT_VAR,
        0,
    };

    static char filename[FILE_NAME_SIZE];

    const char *dst_ext = FILE_EXT_BAS;
    *type = 0;
    char *src_ext = strrchr(name, '.');
    uint16_t len = src_ext ? src_ext - name : strlen(name);
    len = len > FILE_BASE_MAX ? FILE_BASE_MAX : len;

    if (src_ext) {
        dst_ext = 0;
        for (const char **i_ext = g_files_exts; *i_ext; i_ext++) {
            if (strcasecmp(*i_ext, src_ext) == 0) {
                dst_ext = *i_ext;
                break;
            }
            (*type)++;
        }
        // Invalid source extension
        if (!dst_ext) {
            *type = -1;
            return 0;
        }
    }

    strncpy(filename, name, len);
    filename[len] = 0;
    strcat(filename, dst_ext);

    return filename;
}

static void os_loop_connected() {
    uint8_t buffer[NET_BUFFER_MAX];

    // Read data on socket in a non blocking mode
    int ret = hal_net_recv(bmem->bstate.sock, buffer, sizeof(buffer));
    if (ret < 0) {
        // If error on socket: exit the connected mode
        os_disconnect(DB_MIN_SET);
    } else if (ret > 0) {
        // If chars on socket: forward chars to screen (print)
        hal_print_buffer(buffer, ret);
    }

    uint8_t key = hal_get_key();
    // If keyboard has not char: return
    if (key == 0)
        return;

    // Send char to server through the socket
    ret = hal_net_send(bmem->bstate.sock, &key, 1);
    if (ret < 0) {
        // If error on socket: exit the connected mode
        os_disconnect(DB_MIN_SET);
    }

    if (key == '\x1b') {
        os_disconnect(DB_MIN_SET);
    }
}

static void os_loop_basic() {
    char key = os_get_key();
    bastos_send_keys((char *)&key, key != 0 ? 1 : 0, true);
    bastos_loop();
    if (bastos_is_reset()) {
        bastos_done();
        hal_reset();
    }
}

void os_loop() {
    if (bmem->bstate.sock >= 0) {
        os_loop_connected();
    } else {
        os_loop_basic();
    }
}

bool os_debug(void) {
    if (!bmem)
        return false;
    return bmem->bstate.debug != 0.0;
}

void os_setup(void) {
    // Init Basic and display BASTOS banner
    bastos_init();
}
