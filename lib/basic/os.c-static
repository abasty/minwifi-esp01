#include "bio.h"
#include "bmemory.h"
#include "os.h"

#ifdef MINITEL
#include "tty-minitel.h"
#else
#include "tty-vt100.h"
#endif

#define BASTOS_NETWORK_COUNT (20)
#define BASTOS_SERVER_COUNT (20)

#define WIFI_SSID_MAX_SIZE (36)
#define WIFI_SECRET_MAX_SIZE (64)

#define SERVER_NAME_MAX_SIZE (16)
#define SERVER_HOST_MAX_SIZE (64)
#define SERVER_PATH_MAX_SIZE (16)
#define SERVER_LOGIN_MAX_SIZE (16)
#define SERVER_SECRET_MAX_SIZE (64)

typedef struct network_s
{
    int32_t dBm;                       // rssi in dBm
    uint8_t encryption;                // Encryption
    uint8_t count;                     // Count of sucessful connections
    char ssid[WIFI_SSID_MAX_SIZE];     // ssid
    char secret[WIFI_SECRET_MAX_SIZE]; // password / passphrase
    bool available;                    // Available in last scan
} network_t;

typedef struct server_s
{
    int proto;                           // Protocol (TCP, WS, WSS, FTP)
    int port;                            // Port number
    char name[SERVER_NAME_MAX_SIZE];     // Name of the server
    char host[SERVER_HOST_MAX_SIZE];     // IP address / hostname
    char path[SERVER_PATH_MAX_SIZE];     // Path for WS/WSS
    char login[SERVER_LOGIN_MAX_SIZE];   // Login for authentication
    char secret[SERVER_SECRET_MAX_SIZE]; // Password for authentication
} server_t;

// OS WiFi variables
int16_t g_net_count = 0;
int16_t g_known_net_count = 0;
network_t *g_net_store[BASTOS_NETWORK_COUNT + 1] = {0};
int16_t g_net_connected_id = -1;
char g_net_connected_ssid[20] = ""; // 20 first characters of SSID
char g_net_connected_ip[16] = "";

// OS Server variables
// TODO: Order servers by protocol then by name
server_t g_server_store[BASTOS_NETWORK_COUNT] = {0};
int16_t g_server_count = 0;
// int16_t g_minitel_connected_id = -1;
int16_t g_ftp_connected_id = -1;

typedef int (*os_cell_compare_fn)(int16_t a, int16_t b);

static int os_cell_compare_by_count(int16_t a, int16_t b)
{
    return g_net_store[a]->count - g_net_store[b]->count;
}

static int os_cell_compare_by_dBm(int16_t a, int16_t b)
{
    return g_net_store[a]->dBm - g_net_store[b]->dBm;
}

static void os_sort_cells(void* array[], int16_t first, int16_t last, os_cell_compare_fn compare_fn)
{
    // Sort cells using bubble sort
    for (int16_t i = first; i < last; i++)
    {
        for (int16_t j = i + 1; j <= last; j++)
        {
            if (compare_fn(i, j) < 0)
            {
                // Swap cells
                void *temp = array[i];
                array[i] = array[j];
                array[j] = temp;
            }
        }
    }
}

static void os_wifi_sort_networks(void)
{
    os_sort_cells((void **)g_net_store, 0, g_net_count - 1, os_cell_compare_by_count);
    os_sort_cells((void **)g_net_store, 0, g_known_net_count - 1, os_cell_compare_by_dBm);
    os_sort_cells((void **)g_net_store, g_known_net_count, g_net_count - 1, os_cell_compare_by_dBm);
}

static network_t *os_wifi_new_network(const char *ssid, uint8_t encryption, int32_t rssi)
{
    if (g_net_count >= BASTOS_NETWORK_COUNT)
        return 0;

    network_t *new_net = (network_t *)malloc(sizeof(network_t));
    if (!new_net)
        return 0;

    // Initialize the new network
    new_net->dBm = rssi;
    new_net->encryption = encryption;
    new_net->count = 0;
    new_net->available = false;
    strncpy(new_net->ssid, ssid, sizeof(new_net->ssid) - 1);
    new_net->ssid[sizeof(new_net->ssid) - 1] = '\0';
    new_net->secret[0] = '\0';

    // Add the new network to the store
    g_net_store[g_net_count++] = new_net;

    return new_net;
}

static void os_wifi_remove_all_networks(void)
{
    for (int16_t i = 0; i < g_net_count; i++)
    {
        free(g_net_store[i]);
        g_net_store[i] = 0;
    }
    g_net_count = 0;
    g_known_net_count = 0;
}

static void config_load(void)
{
    // TODO: Load number of servers, then servers, then load wifi networks
    int fd = hal_open("$$$CONFIG$$$", B_RDONLY);
    if (fd >= 0)
    {
        network_t net;
        while (hal_read(fd, &net, sizeof(network_t)) == sizeof(network_t))
        {
            network_t *new_net = os_wifi_new_network(net.ssid, net.encryption, net.dBm);
            if (new_net)
            {
                new_net->count = net.count;
                strncpy(new_net->secret, net.secret, sizeof(new_net->secret) - 1);
                new_net->secret[sizeof(new_net->secret) - 1] = '\0';
                g_known_net_count++;
            }
        }
        hal_close(fd);
    }
}

static void config_save(void)
{
    // TODO: Save servers (n servers then servers), then save wifi networks
    int fd = hal_open("$$$CONFIG$$$", B_CREAT | B_WRONLY);
    if (fd >= 0)
    {
        for (int16_t i = 0; i < g_known_net_count; i++)
        {
            network_t *net = g_net_store[i];
            if (net) // Only save valid networks
            {
                hal_write(fd, net, sizeof(network_t));
            }
        }
        hal_close(fd);
    }
}

int16_t os_wifi_get_id_from_ssid(const char *ssid)
{
    for (int16_t i = 0; i < g_net_count; i++)
    {
        if (g_net_store[i] && strcmp(g_net_store[i]->ssid, ssid) == 0)
        {
            return i + 1; // Return ID starting from 1
        }
    }
    return -1; // Not found
}

void os_wifi_add_network(const char *ssid, uint8_t encryption, int32_t rssi)
{
    // Check if the network already exists
    int net_id = os_wifi_get_id_from_ssid(ssid);
    network_t *net = (net_id > 0 && net_id <= g_net_count) ? g_net_store[net_id - 1] : 0;
    if (net)
    {
        // Update existing network
        net->available = true;
        net->encryption = encryption;
        net->dBm = rssi;
        return;
    }
    else
    {
        // If the network does not exist, create a new one
        net = os_wifi_new_network(ssid, encryption, rssi);
    }
    net->available = true;
}

void os_wifi_list(void)
{
    // Display scanning status
    hal_print_string(LINE0 INV "Scanning..." CLEOL NORMAL "\n");

    // Remove all networks that are not known
    for (int16_t i = g_known_net_count; i < g_net_count; i++)
    {
        free(g_net_store[i]);
        g_net_store[i] = 0;
    }
    g_net_count = g_known_net_count;

    // Mark all networks as not available
    for (int16_t i = 0; i < g_net_count; i++)
    {
        g_net_store[i]->available = false;
    }

    // Scan for Wi-Fi networks
    hal_wifi_scan();

    // Sort networks
    os_wifi_sort_networks();

    // Print the list of networks
    hal_print_string("\r\n" INV "ID dBm SSID" CLEOL " " NORMAL "\r\n");
    int n = 0;
    for (int16_t i = 0; i < g_net_count; i++)
    {
        network_t *net = g_net_store[i];
        if (!net->available)
        {
            hal_print_string(INK1);
        }
        n++;
        hal_print_integer("%2d ", n);
        hal_print_integer("%3d ", net->dBm);
        hal_print_string(net->ssid);
        hal_print_string(INK7 "\r\n");
    }
    hal_print_integer("\r\n%d network(s)" CLEOL NORMAL "\r\n\r\n", n);

    // Clear status line
    hal_print_string(LINE0 CLEOL "\n");
}

int os_wifi_connect(int16_t net_id)
{
    if (net_id < 1 || net_id > g_net_count)
        return -1;

    network_t *net = g_net_store[net_id - 1];
    if (!net)
        return -1;

    char secret[64];
    if (net->count == 0)
    {
        hal_print_string(LINE0 INV "Password: " CLEOL);
        if (os_get_string(secret, sizeof(secret), '*') < 0)
        {
            hal_print_string(LINE0 CLEOL "\r\n");
            return -1;
        }
    }
    else
    {
        strncpy(secret, net->secret, sizeof(secret) - 1);
        secret[sizeof(secret) - 1] = '\0';
    }
    hal_print_string(LINE0 INV BLINK "Connecting to ");
    hal_print_string(net->ssid);
    hal_print_string(CLEOL NORMAL "\n");

    g_net_connected_id = -1;
    int ret = hal_wifi_connect(net->ssid, secret);
    if (ret == 0)
    {
        g_net_connected_id = net_id;
        strncpy(net->secret, secret, sizeof(net->secret) - 1);
        net->secret[sizeof(net->secret) - 1] = '\0';
        if (net->count < 255)
        {
            net->count++;
            if (net->count == 1)
                g_known_net_count++;
        }
        os_wifi_sort_networks();
        config_save();
    }
#ifdef MINITEL
    hal_print_string(LINE0 CLEOL "\r\n");
#endif
    return ret;
}

int os_wifi_erase(int16_t net_id)
{
    if (net_id < 1 || net_id > g_net_count)
        return -1;

    // Free the network and remove it from the store
    free(g_net_store[net_id - 1]);

    // Shift remaining networks down
    for (int16_t i = net_id - 1; i < g_net_count - 1; i++)
        g_net_store[i] = g_net_store[i + 1];

    g_net_count--;
    g_net_store[g_net_count] = 0;

    if (net_id <= g_known_net_count)
        g_known_net_count--;

    config_save();

    return 0;
}

void os_wifi_set_info(const char *ssid, const char *ip)
{
    if (ssid)
    {
        strncpy(g_net_connected_ssid, ssid, sizeof(g_net_connected_ssid) - 1);
        g_net_connected_ssid[sizeof(g_net_connected_ssid) - 1] = '\0';
    }
    if (ip)
    {
        strncpy(g_net_connected_ip, ip, sizeof(g_net_connected_ip) - 1);
        g_net_connected_ip[sizeof(g_net_connected_ip) - 1] = '\0';
    }
}

void os_wifi_status(void)
{
    hal_print_string("\r\n" INV "ID IP              SSID" CLEOL " " NORMAL "\r\n");
    g_net_connected_id = hal_wifi_is_connected() ? g_net_connected_id : -1;
    if (g_net_connected_id < 1)
    {
        hal_print_string("-- ---.---.---.--- Not connected");
    }
    else
    {
        if (g_net_connected_id > g_known_net_count)
            hal_print_string("-- ");
        else
            hal_print_integer("%2d ", g_net_connected_id);
        hal_print_string(g_net_connected_ip);
        // Print 16 - len(net->ip) spaces
        uint8_t len = strlen(g_net_connected_ip);
        for (int i = 16 - len; i > 0; i--)
            hal_print_string(" ");
        hal_print_string(g_net_connected_ssid);
    }
    hal_print_string("\r\n\r\n");
}

int os_get_string(char *buf, int size, char secret_char)
{
    int i = 0;
    while (i < size - 1)
    {
        uint8_t key = os_get_key();
        if (key == 0) // No key pressed
            continue;
        if (key == 3) // Ctrl+C
        {
            return -1; // Cancel the input
        }
        if (key == 0x7F) // DEL key
        {
            if (i > 0)
            {
                i--;
                hal_print_string("\b \b"); // Erase last character
            }
            continue;
        }
        if (key == '\r' || key == '\n') // Enter key
        {
            break;
        }
        if (key >= 32 && key <= 126) // Printable characters
        {
            buf[i++] = key;
            const char key_str[2] = {secret_char ? secret_char : key, '\0'};
            hal_print_string(key_str);
        }
    }
    buf[i] = '\0'; // Null-terminate the string
    return i;      // Return the number of characters read
}

uint8_t os_get_key()
{
    static bool fkey = false;
    uint8_t key = hal_get_key();

    if (key == 0)
        return 0; // No key pressed

    if (key == 0x13)
    {
        // Function key pressed
        fkey = true;
        key = 0;
    }
    else
    {
        if (fkey)
        {
            if (key == 0x47)
            {               // CORRECTION key
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x45)
            {            // ANNULATION key
                key = 3; // Convert to Ctrl+C
            }
            else if (key == 0x59)
            {            // CX/FIN key
                key = 0; // Ignore it
                hal_print_string("\x13\x59"); // Send CX/Fin to terminal
            }
            else
            {               // ENVOI and other function keys
                key = '\r'; // Convert to Enter
            }
            fkey = false;
        }
        else
        {
            if (key == 0x08)
            {
                key = 0x7F; // Convert backspace to DEL
            }
            else if (key == 0x1b)
            {
                key = 3; // Convert ESC to Ctrl+C
            }
        }
    }
    return key;
}

int os_connect(const char* urn)
{
    int proto = -1;
    char host[128] = {0};
    const char *path = 0;
    int port = 80;
    int ret = -1;
    const char *part = urn;

    // Get procol part
    if (strncasecmp(urn, "tcp:", 4) == 0)
    {
        part += 4;
        proto = URN_PROTO_TCP;
    }
    else if (strncasecmp(urn, "ws:", 3) == 0)
    {
       part += 3;
       proto = URN_PROTO_WS;
    }
    else if (strncasecmp(urn, "wss:", 4) == 0)
    {
       part += 4;
       proto = URN_PROTO_WSS;
    }

    if (proto < 0)
        goto finalize;

    // Get host
    const char* start = part;
    while (*part != 0 && *part != ':') part++;
    // part refers to '\0' or ':'
    if (part == start || (part - start) >= 128)
        goto finalize;
    strncpy(host, start, part - start);
    host[part - start] = 0;

    // Get port
    if (*part == ':')
    {
        part++;
        char *last;
        port = strtoul(part, &last, 10);
        part = last;

        // Get path
        if (*part == ':')
        {
            part++;
            path = part;
        }
        else if (*part != 0)
        {
            goto finalize;
        }
    }

    // Connext to the host
    ret = hal_net_connect(proto, host, port, path ? path : "");
    if (ret == 0)
    {
        hal_print_string(P_ROULEAU_OFF);
    }

finalize:
    return ret;
}

static void os_disconnect(void)
{
    hal_net_disconnect(bmem->bstate.sock);
    bmem->bstate.sock = -1;

    hal_print_string("\r\n" P_ROULEAU_ON);
    if (!eval_running())
    {
        hal_print_string(CON G0 INK7 "Ready\r\n");
    }
}

void os_cat(void)
{
    hal_print_string("\r\nDrive: A\r\n\r\n");
    size_t total = hal_cat();
    hal_print_integer("\r\n%3uK free\r\n\r\n", total / 1024);
}

void os_cat_file(const char *filename, size_t size)
{
    uint8_t len = strlen(filename);
    hal_print_string(filename);
    for (int i = 16 - len; i > 0; i--)
        hal_print_string(" ");
    hal_print_integer("%u\r\n", size);
}

static void os_loop_connected()
{
    static bool fkey = false;
    uint8_t buffer[NET_BUFFER_MAX];

    // Read data on socket in a non blocking mode
    int ret = hal_net_recv(bmem->bstate.sock, buffer, sizeof(buffer));
    if (ret < 0)
    {
        // If error on socket: exit the connected mode
        os_disconnect();
    }
    else if (ret > 0)
    {
        // If chars on socket: forward chars to screen (print)
        hal_print_buffer(buffer, ret);
    }

    uint8_t key = hal_get_key();
    // If keyboard has not char: return
    if (key == 0)
        return;

    // Send char to server through the socket
    ret = hal_net_send(bmem->bstate.sock, &key, 1);
    if (ret < 0)
    {
        // If error on socket: exit the connected mode
        os_disconnect();
    }

    // If Cx/Fin: close socket [exit the connected mode]
    if (key == 0x13)
    {
        fkey = true;
    }
    else
    {
        if (fkey)
        {
            if (key == 'Y') // CX/Fin
            {
                os_disconnect();
            }
            fkey = false;
        }
    }
}

static void os_loop_basic()
{
    char key = os_get_key();
    bastos_send_keys((char *)&key, key != 0 ? 1 : 0, true);
    bastos_loop();
    if (bastos_is_reset())
    {
        bastos_done();
        hal_reset();
    }
}

void os_loop()
{
    if (bmem->bstate.sock >= 0)
    {
        os_loop_connected();
    }
    else
    {
        os_loop_basic();
    }
}

void os_setup(void)
{
    // Remove all networks
    os_wifi_remove_all_networks();

    // Load config
    config_load();

    // Init Basic and display BASTOS banner
    bastos_init();
    bastos_send_keys("bastos\n", 7, false);
}
