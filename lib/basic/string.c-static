#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "bmemory.h"

static char *string_cstr(const char *string) {
    return string ? ((char *)string) + 2 : 0;
}

static int string_len(const char *string) {
    if (!string)
        return 0;

    uint8_t *len_ptr = (uint8_t *)string;
    uint16_t len = (len_ptr[0] | (len_ptr[1] << 8));
    return len;
}

static char *string_dup(const char *string) {
    if (!string)
        return 0;

    uint16_t len = string_len(string);
    char *dup = bmem_string_alloc(len);
    memcpy(string_cstr(dup), string_cstr(string), len);
    return dup;
}

static void string_slice(char **string, uint16_t start, uint16_t end) {
    if (!*string)
        return;

    if (!**string) {
        *string = 0;
        return;
    }

    uint16_t len = string_len(*string);
    end = end < 1 || end > len ? len : end;
    start = start < 1 ? 1 : start;
    uint16_t slice_len = end - start < 0 ? 0 : end - start + 1;

    char *slice = bmem_string_alloc(slice_len);
    if (!slice) {
        *string = 0;
        return;
    }

    char *src = *string + start - 1 + 2;
    char *dst = slice + 2;
    while (slice_len > 0) {
        *dst++ = *src++;
        slice_len--;
    }
    *dst = 0;
    *string = slice;
}

static void string_concat(char **string1, char *string2) {
    // FIXME: !!!! segfault if string2 == 0 (seems to be a || instead of &&)
    // FIXME: The test *string2 has no sense w/ bstrings (2 first chars are
    // length)
    if (!string2 && !*string2)
        string2 = 0;

    if (!string2)
        return;

    // FIXME: Test against string_len
    if (!*string1) {
        *string1 = string2;
        return;
    }

    // This line of code needs no null *string1 and string2
    uint16_t len = string_len(*string1) + string_len(string2);
    char *concat = bmem_string_alloc(len);
    char *dst = concat + 2;
    char *src = *string1 + 2;
    while (*src)
        *dst++ = *src++;
    src = string2 + 2;
    while (*src)
        *dst++ = *src++;
    *dst = 0;
    *string1 = concat;
}

