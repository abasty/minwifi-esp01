static void running_state_clear() {
    bmem->bstate.pc = 0;
    bmem->bstate.pc_offset = 0;
    bmem->bstate.sp = 0;
    bmem->bstate.for_sp = 0;
    bmem->list_start = 0;
    memset(bmem->loops, 0, sizeof(bmem->loops));
    bmem->inkey = 0;
    bmem->ofs_c = 0;
    bmem->ofs_l = 0;
}

static bool eval_token(uint8_t c) {
    if (*bmem->bstate.read_ptr != c) {
        return false;
    }
    bmem->bstate.token = *bmem->bstate.read_ptr++;
    return true;
}

static uint8_t eval_token_one_of(const char *set) {
    char c = *bmem->bstate.read_ptr;

    while (*set && c != *set) {
        set++;
    }
    if (!*set) {
        return 0;
    }
    bmem->bstate.token = c;
    bmem->bstate.read_ptr++;
    return c;
}

uint8_t string_to_number_functions[] = {
    TOKEN_KEYWORD_CODE,
    TOKEN_KEYWORD_LEN,
    TOKEN_KEYWORD_VAL,
    0,
};

static void eval_val() {

    eval_state_t saved_state = bmem->bstate;
    float number = 0.0;
    int8_t err = -1;

    // Dupplicate input
    char *input_dup = string_dup(bmem->bstate.string);

    // Tokenize command
    tokenizer_state_t line;
    if (tokenize(&line, string_cstr(input_dup), true) < 0)
        goto finalize;

    // Set read pointer to tokenized input
    bmem->bstate.read_ptr = bmem->bstate.token_buffer.line;

    // Do syntax check / eval
    bool eval = eval_expr(TOKEN_NUMBER);
    if (!eval)
        goto finalize;

    number = bmem->bstate.number;
    err = 0;

finalize:
    bmem->bstate = saved_state;
    bmem->bstate.number = err == 0 ? number : 0.0;
    bmem->bstate.error = err == 0 ? BERROR_NONE : BERROR_SYNTAX;
}

static bool eval_string_to_number() {
    uint8_t token;

    if ((token = eval_token_one_of((char *)string_to_number_functions)) == 0)
        return false;

    bool brackets = eval_token('(');

    if (!eval_string_expr())
        return false;

    if (brackets && !eval_token(')'))
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    if (!bmem->bstate.string) {
        bmem->bstate.number = 0;
        return true;
    }

    if (token == TOKEN_KEYWORD_LEN) {
        bmem->bstate.number = string_len(bmem->bstate.string);
        return true;
    }

    if (token == TOKEN_KEYWORD_VAL) {
        eval_val();
        return true;
    }

    // token == TOKEN_KEYWORD_CODE
    bmem->bstate.number = bmem->bstate.string[2];
    return true;
}

static bool eval_index() {

    if (!eval_token(TOKEN_KEYWORD_INDEX))
        return false;

    bool brackets = eval_token('(');

    if (!eval_expr(TOKEN_STRING))
        return false;

    char *string1= bmem->bstate.string;

    if (!eval_token(','))
        return false;

    if (!eval_expr(TOKEN_STRING))
        return false;

    char *string2= bmem->bstate.string;

    uint16_t index = 1;

    if (eval_token(',')) {
        if (!eval_expr(TOKEN_NUMBER))
            return false;
        index = bmem->bstate.number;
    }
    if (brackets && !eval_token(')'))
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    bmem->bstate.token = TOKEN_NUMBER;
    bmem->bstate.number = string_index(string1, string2, index);
    return true;
}

static bool eval_number() {
    bool minus = eval_token('-');
    float value = 0;

    if (eval_token(TOKEN_KEYWORD_PI)) {
        value = 3.1415926536;
    } else if (eval_token(TOKEN_KEYWORD_RND)) {
        value = (float)((double)rand() / (double)RAND_MAX);
    } else if (eval_token(TOKEN_KEYWORD_VKEY)) {
        value = bmem->vkey;
    } else if (eval_token(TOKEN_NUMBER)) {
        uint8_t *write_value_ptr = (uint8_t *)&value;
        *write_value_ptr++ = *bmem->bstate.read_ptr++;
        *write_value_ptr++ = *bmem->bstate.read_ptr++;
        *write_value_ptr++ = *bmem->bstate.read_ptr++;
        *write_value_ptr++ = *bmem->bstate.read_ptr++;
    } else if (eval_token(TOKEN_VARIABLE_NUMBER)) {
        char *name = (char *)bmem->bstate.read_ptr - 1;
        bmem->bstate.read_ptr += strlen(name);

        uint8_t dim = 0;
        uint32_t dims[B_DIM_MAX];

        eval_array_ref(TOKEN_VARIABLE_NUMBER, &dim, dims);

        if (bmem->bstate.do_eval) {
            if (dim == 0) {
                var_t *var = bmem_var_get(name);
                if (var) {
                    value = var->numbers[0];
                } else {
                    value = 0;
                }
            } else {
                float *number = bmem_number_array_get_cell(name, dim, dims);
                if (!number) {
                    bmem->bstate.error = BERROR_RANGE;
                    return true;
                }
                value = *number;
            }
        }
    } else {
        return false;
    }

    bmem->bstate.number = value;
    bmem->bstate.token = TOKEN_NUMBER;
    if (minus) {
        bmem->bstate.number = -bmem->bstate.number;
    }
    return true;
}

static uint8_t eval_graphic_fn(uint8_t fn, int8_t x, int8_t y, char *codes) {
    if (x < 0 || x > 79 || y < 0 || y > 71) {
        bmem->bstate.error = BERROR_RANGE;
        return 0;
    }
    static const uint8_t point[3][2] = {
        {1, 2},
        {4, 8},
        {16, 64},
    };
    uint16_t C = (x + 2) / 2;
    uint16_t L = (71 - y) / 3 + 1;
    uint16_t c = x % 2;
    uint16_t l = (71 - y) % 3;
    uint8_t *addr = &bmem->screen[L - 1][C - 1];
    uint8_t cbit = point[l][c];
    if (fn == TOKEN_KEYWORD_TEST) {
        return *addr & cbit;
    }
    if (fn == TOKEN_KEYWORD_PLOT) {
        *addr |= cbit;
    } else if (fn == TOKEN_KEYWORD_UNPLOT) {
        *addr &= ~cbit;
    }
    if (bmem->bstate.screen_mode) {
        codes += sprintf(codes, MODE80_CUR, L + MODE80_CUR_DELTA_V, C + MODE80_CUR_DELTA_H);
    } else {
        codes += sprintf(codes, CUR, L + CUR_DELTA_V, C + CUR_DELTA_H);
        if (bmem->paper != 0) {
            codes += sprintf(codes, PAPER, bmem->paper + PAPER_DELTA);
        }
        if (bmem->ink != 7) {
            codes += sprintf(codes, INK, bmem->ink + INK_DELTA);
        }
    }
    codes += sprintf(codes, G1 "%c", *addr + ' ');
    return cbit;
}

static bool eval_function() {
    if (!eval_token_one_of((char *)functions)) {
        return false;
    }
    uint8_t f = bmem->bstate.token;
    if (!eval_factor()) {
        return false;
    }
    switch (f) {
    case TOKEN_KEYWORD_ABS:
        bmem->bstate.number = fabsf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_ACS:
        bmem->bstate.number = acosf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_ASN:
        bmem->bstate.number = asinf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_ATN:
        bmem->bstate.number = atanf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_BIN:
        // FIXME
        break;
    case TOKEN_KEYWORD_COS:
        bmem->bstate.number = cosf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_EXP:
        bmem->bstate.number = expf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_INT:
        bmem->bstate.number = truncf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_NOT:
        bmem->bstate.number = truncf(bmem->bstate.number) == 0 ? 1 : 0;
        break;
    case TOKEN_KEYWORD_LN:
        bmem->bstate.number = logf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_SGN:
        bmem->bstate.number =
            (bmem->bstate.number > 0) - (bmem->bstate.number < 0);
        break;
    case TOKEN_KEYWORD_SIN:
        bmem->bstate.number = sinf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_SQR:
        bmem->bstate.number = sqrtf(bmem->bstate.number);
        break;
    case TOKEN_KEYWORD_TAN:
        bmem->bstate.number = tanf(bmem->bstate.number);
        break;
    default:
        return false;
    }
    return true;
}

static bool eval_test() {
    if (!eval_token(TOKEN_KEYWORD_TEST))
        return false;

    if (!eval_factor())
        return false;

    int8_t x = bmem->bstate.number;

    if (!eval_token(','))
        return false;

    if (!eval_factor())
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    int8_t y = bmem->bstate.number;
    bmem->bstate.number = eval_graphic_fn(TOKEN_KEYWORD_TEST, x, y, 0) != 0;

    return true;
}

static bool eval_factor() {
    bool result =
        eval_number()  || eval_test() || eval_function() || eval_string_to_number() || eval_index() ||
        (eval_token('(') && eval_expr(TOKEN_NUMBER) && eval_token(')'));
    return result;
}

static bool eval_term() {
    bool result = true;
    float acc = 0;
    if ((result = eval_factor())) {
        acc = bmem->bstate.number;
        while (eval_token_one_of("*/%")) {
            uint8_t op = bmem->bstate.token;
            result = eval_factor();
            if (!result) {
                break;
            }
            switch (op) {
            case '*':
                acc *= bmem->bstate.number;
                break;
            case '/':
                acc /= bmem->bstate.number;
                break;
            case '%':
                if ((int)(truncf(bmem->bstate.number)) != 0) {
                    acc =
                        (int)(truncf(acc)) % (int)(truncf(bmem->bstate.number));
                } else {
                    acc = INFINITY;
                }
                break;
            }
            bmem->bstate.number = acc;
        }
    }
    bmem->bstate.token = TOKEN_NUMBER;
    return result;
}

static bool eval_float_expr() {
    bool result = true;
    float acc = 0;
    if ((result = eval_term())) {
        acc = bmem->bstate.number;
        while (eval_token_one_of("+-|&")) {
            uint8_t op = bmem->bstate.token;
            result = eval_term();
            if (!result) {
                break;
            }
            switch (op) {
            case '+':
                acc += bmem->bstate.number;
                break;
            case '-':
                acc -= bmem->bstate.number;
                break;
            case '&':
                acc = (int)(truncf(acc)) & (int)(truncf(bmem->bstate.number));
                break;
            case '|':
                acc = (int)(truncf(acc)) | (int)(truncf(bmem->bstate.number));
                break;
            }
            bmem->bstate.number = acc;
        }
        bmem->bstate.token = TOKEN_NUMBER;
    }
    return result;
}

static bool eval_compare_expr() {
    if (!eval_float_expr() && !eval_string_expr())
        return false;

    uint8_t type_token = bmem->bstate.token;

    if (eval_token_one_of(compare_tokens)) {
        uint8_t op = bmem->bstate.token;
        float result = 0;

        if (type_token == TOKEN_NUMBER) {
            float arg1 = bmem->bstate.number;

            if (!eval_float_expr())
                return false;

            result = arg1 - bmem->bstate.number;
        } else { // type_token == TOKEN_STRING
            char *string1 = string_cstr(bmem->bstate.string);

            if (!eval_string_expr())
                return false;

            if (bmem->bstate.do_eval) {
                char *string2 = string_cstr(bmem->bstate.string);
                result = strcmp(string1 ? string1 : "", string2 ? string2 : "");
            } else {
                result = 0;
            }
        }
        switch (op) {
        case '=':
            bmem->bstate.number = result == 0;
            break;
        case '<':
            bmem->bstate.number = result < 0;
            break;
        case '>':
            bmem->bstate.number = result > 0;
            break;
        case TOKEN_COMPARE_NE:
            bmem->bstate.number = result != 0;
            break;
        case TOKEN_COMPARE_LE:
            bmem->bstate.number = result <= 0;
            break;
        case TOKEN_COMPARE_GE:
            bmem->bstate.number = result >= 0;
            break;
        }
        bmem->bstate.token = TOKEN_NUMBER;
    }

    return true;
}

static bool eval_expr(uint8_t type_token) {
    if (!eval_compare_expr())
        return false;

    if (bmem->bstate.token == TOKEN_STRING)
        return (type_token & TOKEN_STRING) != 0;

    float acc = bmem->bstate.number == 0 ? 0 : 1;
    bool is_bool_expr = false;

    while (eval_token(TOKEN_KEYWORD_AND) || eval_token(TOKEN_KEYWORD_OR)) {
        uint8_t op = bmem->bstate.token;

        if (!eval_compare_expr())
            return false;

        float arg = bmem->bstate.number == 0 ? 0 : 1;

        if (op == TOKEN_KEYWORD_AND) {
            acc = acc && arg;
        } else {
            acc = acc || arg;
        }
        is_bool_expr = true;
    }
    if (is_bool_expr) {
        bmem->bstate.number = acc;
    }

    return (type_token & TOKEN_NUMBER) != 0;
}

static bool eval_string_chr() {
    if (!eval_token(TOKEN_KEYWORD_CHR))
        return false;

    if (!eval_term())
        return false;

    if (bmem->bstate.do_eval) {
        bmem->bstate.string = bmem_string_alloc(1);
        if (!bmem->bstate.string)
            return false;

        bmem->bstate.string[2] = (char)((uint8_t)(truncf(bmem->bstate.number)));
    }

    return true;
}

static bool eval_string_str() {
    if (!eval_token(TOKEN_KEYWORD_STR))
        return false;

    if (!eval_term())
        return false;

    if (bmem->bstate.do_eval) {
        bmem->bstate.string = bmem_string_alloc(16);
        if (!bmem->bstate.string)
            return false;

        int slen = sprintf(string_cstr(bmem->bstate.string), "%g", bmem->bstate.number);
        ((uint8_t *)bmem->bstate.string)[0] = (uint8_t)(slen & 0xff);
        ((uint8_t *)bmem->bstate.string)[1] = (uint8_t)(slen >> 8);
    }

    return true;
}

static bool eval_string_rep() {
    if (!eval_token(TOKEN_KEYWORD_REP))
        return false;

    if (!eval_term())
        return false;

    uint8_t n = bmem->bstate.number;

    if (!eval_token(','))
        return false;

    if (!eval_string_expr())
        return false;

    if (bmem->bstate.do_eval) {
        uint16_t len = string_len(bmem->bstate.string);
        const char *in = string_cstr(bmem->bstate.string);
        if (len == 0)
            return true;

        if (len > 1 || n <= 3 || *in < ' ') {
            char *out = bmem_string_alloc(n * len);
            if (!out)
                return false;
            bmem->bstate.string = out;
            out += 2;
            for (int i = 0; i < n; i++) {
                memcpy(out, in, len);
                out += len;
            }
            *out = 0;
        } else {
            char *out = bmem_string_alloc(((n / 63) + 1) * 3);
            if (!out)
                return false;
            bmem->bstate.string = out;
            out += 2;
            *out++ = *in;
            int r = n - 1;
            while (r > 63) {
                *out++ = '\x12';
                *out++ = '\x7f';
                r -= 63;
            }
            if (r > 2) {
                *out++ = '\x12';
                *out++ = (char) (0x40 + r);
            } else {
                while (r > 0) {
                    *out++ = *in;
                    r--;
                }
            }
            *out = 0;
        }
    }
    return true;
}

static bool eval_string_get() {
    uint8_t set;

    if (!eval_token(TOKEN_KEYWORD_GET))
        return false;

    bool brackets = eval_token('(');

    if (!eval_expr(TOKEN_NUMBER))
        return false;

    set = (uint8_t)bmem->bstate.number;
    bool entry = false;

    if (eval_token(',')) {
        if (!eval_expr(TOKEN_STRING))
            return false;
        entry = true;
    }

    if (brackets && !eval_token(')'))
        return false;

    if (bmem->bstate.do_eval) {
        if (entry) {
            // Wifi password are write only
            entry_t *entry = set == DB_WIFI_SET ? 0 : bdb_entry_get(set, string_cstr(bmem->bstate.string));
            bmem->bstate.string = entry ? string_dup(entry->string) : bmem_string_alloc(0);
        } else {
            bmem->bstate.string = bdb_get_keys(set);
        }
    }

    return true;
}

static bool eval_string_file() {
    if (!eval_token(TOKEN_KEYWORD_FILE))
        return false;

    bool brackets = eval_token('(');

    if (!eval_expr(TOKEN_STRING))
        return false;

    char* pathname = bmem->bstate.string + 2;
    uint16_t size = 0;
    uint16_t offset = 0;

    if (eval_token(',')) {
        if (!eval_expr(TOKEN_NUMBER))
            return false;
        offset = (uint16_t) bmem->bstate.number;
        if (!eval_token(','))
            return false;
        if (!eval_expr(TOKEN_NUMBER))
            return false;
        size = (uint16_t) bmem->bstate.number;
    }

    if (brackets && !eval_token(')'))
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    if (size == 0) {
        size = hal_get_file_size(pathname);
    }

    bmem->bstate.string = 0;

    if (size > FILE_READ_MAX_SIZE) {
        bmem->bstate.error = BERROR_RANGE;
        return true;
    }

    if (size == 0) {
        return true;
    }

    bmem->bstate.string = bmem_string_alloc(size);
    if (!bmem->bstate.string) {
        bmem->bstate.error = BERROR_MEMORY;
        return true;
    }

    int rsize = hal_file(pathname, string_cstr(bmem->bstate.string), offset, size);
    bmem->bstate.string[0] = rsize & 0xff;
    bmem->bstate.string[1] = rsize >> 8;

    return true;
}

static bool eval_string_inkey() {
    if (!eval_token(TOKEN_KEYWORD_INKEY))
        return false;

    if (bmem->bstate.do_eval) {
        bmem->bstate.string =
            bmem_string_alloc(bmem->inkey == 0 ? 0 : 1);
        if (!bmem->bstate.string)
            return false;

        if (bmem->inkey != 0) {
            bmem->bstate.string[2] = bmem->inkey;
        }

        bmem->inkey = 0;
    }

    return true;
}

static bool eval_string_const() {
    if (!eval_token(TOKEN_STRING))
        return false;

    uint16_t len = (bmem->bstate.read_ptr[0] | (bmem->bstate.read_ptr[1] << 8));
    bmem->bstate.string = (char *)bmem->bstate.read_ptr;
    bmem->bstate.read_ptr += 2 + len + 1;
    return true;
}

static bool eval_string_var() {
    if (!eval_token(TOKEN_VARIABLE_STRING))
        return false;

    char *name = (char *)bmem->bstate.read_ptr - 1;
    while (*bmem->bstate.read_ptr++)
        ;

    uint8_t dim_count = 0;
    uint32_t dims[B_DIM_MAX];

    eval_array_ref(TOKEN_VARIABLE_STRING, &dim_count, dims);

    if (bmem->bstate.do_eval) {
        uint16_t len;
        char *cstr = bmem_var_get_cstr_and_slice(name, &dim_count, dims, &len);
        if (!cstr) {
            bmem->bstate.error = BERROR_RANGE;
            return true;
        }
        if (dim_count == 0) {
            // String var and no slice: Use the string pointer
            bmem->bstate.string = cstr - 2;
            return true;
        }
        if (dim_count < 2) {
            // Wrong number of given indexes (at least one slice / 2 indexes are
            // needed)
            bmem->bstate.error = BERROR_RANGE;
            return true;
        }

        uint16_t start = dims[dim_count - 2];
        uint16_t end = dims[dim_count - 1];
        end = end < 1 || end > len ? len : end;
        start = start < 1 ? 1 : start;
        len = end - start < 0 ? 0 : end - start + 1;

        bmem->bstate.string = bmem_string_alloc(len);
        if (!bmem->bstate.string) {
            bmem->bstate.error = BERROR_MEMORY;
            return true;
        }
        memcpy(string_cstr(bmem->bstate.string), cstr + start - 1, len);
    }
    return true;
}

static bool eval_string_term() {
    bool result = eval_string_const() || eval_string_var() || eval_string_chr() ||
                  eval_string_tty() || eval_string_str() || eval_string_rep() ||
                  eval_string_get() || eval_string_file() || eval_string_inkey() ||
                  (eval_token('(') && eval_string_expr() && eval_token(')'));

    if (!result)
        return false;

    // Optional range
    if (!eval_token('('))
        return true;

    uint16_t start = 1;
    uint16_t end = 0;

    if (eval_expr(TOKEN_NUMBER)) {
        start = bmem->bstate.number < 1 ? 1 : bmem->bstate.number;
        end = start;
    }

    if (eval_token(TOKEN_KEYWORD_TO)) {
        if (eval_expr(TOKEN_NUMBER)) {
            end = bmem->bstate.number;
        } else {
            end = 0;
        }
    }

    if (!eval_token(')'))
        return false;

    if (bmem->bstate.do_eval) {
        string_slice(&bmem->bstate.string, start, end);
    }

    return result;
}

static bool eval_string_expr() {
    bool result = true;
    if ((result = eval_string_term())) {
        char *string1 = bmem->bstate.string;

        while (eval_token('+')) {
            result = eval_string_term();
            if (!result)
                break;

            if (bmem->bstate.do_eval) {
                string_concat(&string1, bmem->bstate.string);
            }
        }
        if (bmem->bstate.do_eval) {
            bmem->bstate.string = string1;
        }
        bmem->bstate.token = TOKEN_STRING;
    }
    return result;
}

static bool eval_variable_ref() {
    bmem->bstate.var_ref = (char *)bmem->bstate.read_ptr;

    if (!eval_token_one_of((char *)variables))
        return false;

    // Pass variable chars until zero
    while (*bmem->bstate.read_ptr++)
        ;

    return true;
}

static bool eval_array_ref(uint8_t token, uint8_t *dim_count, uint32_t *dims) {
    if (!eval_token('('))
        return false;

    *dim_count = 0;

    while (eval_float_expr() || eval_token(TOKEN_KEYWORD_TO)) {

        if (bmem->bstate.token == TOKEN_KEYWORD_TO) {
            dims[*dim_count] = 1;
            (*dim_count)++;
            (*dim_count) |= B_DIM_RANGE_FLAG;
            break;
        }

        if (bmem->bstate.do_eval) {
            if ((*dim_count & ~B_DIM_RANGE_FLAG) >= B_DIM_MAX - 1) {
                bmem->bstate.error = BERROR_RANGE;
                return true;
            }

            if (bmem->bstate.number < 1 ||
                bmem->bstate.number >= BASTOS_MEMORY_SIZE) {
                bmem->bstate.error = BERROR_RANGE;
                return true;
            }
        }
        dims[*dim_count] = bmem->bstate.number;
        (*dim_count)++;

        if (eval_token(','))
            continue;

        if (eval_token(TOKEN_KEYWORD_TO)) {
            (*dim_count) |= B_DIM_RANGE_FLAG;
            break;
        }
        break;
    }

    if ((*dim_count & B_DIM_RANGE_FLAG) != 0) {
        if (eval_float_expr()) {
            if (bmem->bstate.do_eval) {
                if (bmem->bstate.number < 1 ||
                    bmem->bstate.number >= BASTOS_MEMORY_SIZE) {
                    bmem->bstate.error = BERROR_RANGE;
                    return true;
                }
                dims[*dim_count & ~B_DIM_RANGE_FLAG] = bmem->bstate.number;
            }
        } else {
            dims[*dim_count & ~B_DIM_RANGE_FLAG] = BASTOS_MEMORY_SIZE;
        }
        (*dim_count)++;
    }

    return eval_token(')');
}

static bool eval_dim() {
    if (!eval_token(TOKEN_KEYWORD_DIM))
        return false;

    if (!eval_variable_ref())
        return false;

    char *name = bmem->bstate.var_ref;
    uint8_t token = name[0];

    uint8_t dim = 0;
    uint32_t dims[B_DIM_MAX];

    if (!eval_array_ref(token, &dim, dims))
        return false;

    if (dim == 0)
        return false;

    if ((dim & B_DIM_RANGE_FLAG) != 0)
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    // Copy name in tmp
    char tmp[B_NAME_SIZE_MAX];
    token |= TOKEN_ARRAY_FLAG;
    strncpy(tmp, name, B_NAME_SIZE_MAX - 1);
    tmp[B_NAME_SIZE_MAX - 1] = 0;
    tmp[0] = token;

    // Remove existing variable
    var_t *var = bmem_var_get(tmp);
    if (var)
        bmem_var_unset(var);

    // Create variable
    var = bmem_var_new(tmp, token, dim, dims);
    if (!var)
        bmem->bstate.error = BERROR_MEMORY;

    return true;
}

static bool eval_put() {
    uint8_t set;

    if (!eval_token(TOKEN_KEYWORD_PUT))
        return false;

    bool brackets = eval_token('(');

    if (!eval_expr(TOKEN_NUMBER))
        return false;

    set = (uint16_t)bmem->bstate.number;

    if (!eval_token(','))
        return false;

    if (!eval_expr(TOKEN_STRING))
        return false;

    if (!eval_token(','))
        return false;

    char *key = 0;
    if (bmem->bstate.do_eval) {
        key = string_dup(bmem->bstate.string);
    }

    if (!eval_expr(TOKEN_STRING))
        return false;

    if (brackets && !eval_token(')'))
        return false;

    if (bmem->bstate.do_eval) {
        bdb_entry_set(set, string_cstr(key), bmem->bstate.string, false);
        os_db_save();
    }

    return true;
}

static bool eval_output() {
    if (!eval_token(TOKEN_KEYWORD_OUTPUT))
        return false;

    uint8_t func = eval_token_one_of((char *)output_func);
    func = func == 0 ? TOKEN_KEYWORD_START : func;

    if (func == TOKEN_KEYWORD_START) {
        if (!eval_variable_ref())
            return false;

        if (bmem->bstate.token != TOKEN_VARIABLE_STRING)
            return false;
    }

    if (!bmem->bstate.do_eval)
        return true;

    // Store var ref ou var name (first N chars)
    if (func == TOKEN_KEYWORD_START) {
        strncpy(bmem->output_var, bmem->bstate.var_ref,
                B_NAME_SIZE_MAX - 1);
        bmem->output_var[B_NAME_SIZE_MAX - 1] = 0;
        bmem_var_string_set(bmem->output_var, "", true);
    } else {
        *bmem->output_var = 0;
    }
    return true;
}

static bool eval_let() {
    eval_token(TOKEN_KEYWORD_LET);

    if (!eval_variable_ref())
        return false;

    char *name = bmem->bstate.var_ref;
    uint8_t token = *((uint8_t *)name);

    uint8_t dim = 0;
    uint32_t dims[B_DIM_MAX];

    eval_array_ref(token, &dim, dims);

    if (!eval_token('='))
        return false;

    if (token == TOKEN_VARIABLE_NUMBER) {
        if (!eval_expr(TOKEN_NUMBER))
            return false;

        if (bmem->bstate.do_eval) {
            // Manage simple variable
            if (dim == 0)
                return bmem_var_number_set(name, bmem->bstate.number) != 0;

            // Manage array
            float *number = bmem_number_array_get_cell(name, dim, dims);
            if (!number) {
                bmem->bstate.error = BERROR_RANGE;
                return true;
            }
            *number = bmem->bstate.number;
        }
        return true;
    } else if (token == TOKEN_VARIABLE_STRING) {
        if (!eval_expr(TOKEN_STRING))
            return false;

        if (bmem->bstate.do_eval) {
            if (dim == 0)
                return bmem_var_string_set(name, bmem->bstate.string, false) !=
                       0;

            // Manage array and slice
            uint16_t len;
            char *string = bmem_var_get_cstr_and_slice(name, &dim, dims, &len);
            if (!string) {
                bmem->bstate.error = BERROR_RANGE;
                return true;
            }
            // Compute slice parameters
            uint16_t start = dims[dim - 2];
            uint16_t end = dims[dim - 1];
            end = end < 1 || end > len ? len : end;
            start = start < 1 ? 1 : start;
            uint16_t n = end - start < 0 ? 0 : end - start + 1;

            // Empty slice
            if (n == 0)
                return true;

            // Set slice chars from source string
            uint8_t *src = (uint8_t *)string_cstr(bmem->bstate.string);
            uint8_t *dst = (uint8_t *)string + start - 1;
            while (n) {
                if (src && *src) {
                    *dst++ = *src++;
                } else {
                    *dst++ = ' ';
                }
                n--;
            }
        }
        return true;
    }

    return false;
}

static int8_t eval_input_store(char *io_string) {
    eval_input_mode(false);

    // Comment out the next two lines to support "no change on empty input"
    // if (strlen(io_string) == 0)
    //     return BERROR_NONE;

    if (bmem->bstate.input_var_token == TOKEN_VARIABLE_NUMBER) {
        char *end_ptr = 0;
        float value = strtof(io_string, &end_ptr);
        if (end_ptr - io_string != strlen(io_string))
            return BERROR_SYNTAX;

        if (bmem_var_number_set(name_of_var(bmem->bstate.input_var), value) ==
            0)
            return BERROR_MEMORY;

        return BERROR_NONE;
    } else if (bmem->bstate.input_var_token == TOKEN_VARIABLE_STRING) {
        if (bmem_var_string_set(name_of_var(bmem->bstate.input_var), io_string,
                                true) == 0)
            return BERROR_MEMORY;

        return BERROR_NONE;
    }
    return BERROR_SYNTAX;
}

static bool eval_input() {
    if (!eval_token(TOKEN_KEYWORD_INPUT))
        return false;

    if (eval_string_const()) {
        if (bmem->bstate.do_eval) {
            hal_print_buffer((uint8_t *)string_cstr(bmem->bstate.string),
                             string_len(bmem->bstate.string));
        }

        if (!eval_token(','))
            return false;
    }

    if (!eval_variable_ref())
        return false;

    if (bmem->bstate.do_eval) {
        bmem->bstate.input_var = 0;
        bmem->bstate.input_var_token = bmem->bstate.token;

        // Create input variable
        if (bmem->bstate.input_var_token == TOKEN_VARIABLE_NUMBER) {
            bmem->bstate.input_var = bmem_var_get(bmem->bstate.var_ref);
            if (bmem->bstate.input_var == 0) {
                bmem->bstate.input_var =
                    bmem_var_number_set(bmem->bstate.var_ref, 0);
            }
        } else if (bmem->bstate.input_var_token == TOKEN_VARIABLE_STRING) {
            bmem->bstate.input_var = bmem_var_get(bmem->bstate.var_ref);
            if (bmem->bstate.input_var == 0) {
                bmem->bstate.input_var =
                    bmem_var_string_set(bmem->bstate.var_ref, "", true);
            }
        }
        if (bmem->bstate.input_var == 0)
            return false;

        // Go to input mode
        eval_input_mode(true);
    }
    return true;
}

static bool eval_print(bool implicit) {
    if (!implicit && !eval_token(TOKEN_KEYWORD_PRINT))
        return false;

    if (implicit) {
        // rewind to tty / string token
        bmem->bstate.read_ptr--;
    }

    bool result = true;
    bool ln = true;

    while (result && *bmem->bstate.read_ptr != 0 &&
           *bmem->bstate.read_ptr != ':' && *bmem->bstate.read_ptr != '\'') {
        ln = true;
        if (eval_expr(TOKEN_NUMBER | TOKEN_STRING)) {
            if (bmem->bstate.do_eval) {
                if (bmem->bstate.token == TOKEN_NUMBER) {
                    os_redir_print_float(bmem->bstate.number);
                } else { // TOKEN_STRING
                    os_redir_print_buffer(string_cstr(bmem->bstate.string),
                                          string_len(bmem->bstate.string));
                }
            }
        } else if (eval_string_tty()) {
            if (bmem->bstate.do_eval) {
                os_redir_print_string(string_cstr(bmem->bstate.string));
            }
        } else if (eval_token(',')) {
            if (bmem->bstate.do_eval) {
                os_redir_print_string(" ");
            }
        } else if (eval_token(';')) {
            ln = false;
        } else {
            result = *bmem->bstate.read_ptr == 0;
        }
    }

    if (result && bmem->bstate.do_eval) {
        if (ln && !implicit) {
            os_redir_print_string("\r\n");
        }
    }

    return result;
}

static bool eval_list() {
    if (!eval_token(TOKEN_KEYWORD_LIST) && !eval_token(TOKEN_KEYWORD_LL))
        return false;

    uint16_t start = 0;
    uint16_t n = 20;

    if (eval_number()) {
        start = bmem->bstate.number;
        if (eval_token(',')) {
            if (!eval_number())
                return false;

            n = bmem->bstate.number;
        }
    }
    else {
        start = bmem->list_start;
    }

    if (bmem->bstate.do_eval) {
        prog_t *prog = bmem_prog_first_line();
        while (prog && n >= 1) {
            if (prog->line_no >= start) {
                os_redir_print_integer("%4d", (int)prog->line_no);
                char c[2];
                c[0] = bmem->bstate.pc == prog ? '>' : ' ';
                c[1] = 0;
                os_redir_print_string(c);
                os_redir_print_string(untokenize(prog->line));
                os_redir_print_string("\r\n");
                n--;
            }
            prog = bmem_prog_next_line(prog);
            bmem->list_start = prog ? prog->line_no : 0;
        }
    }

    return true;
}

static inline void eval_input_mode(bool mode) { bmem->bstate.inputting = mode ? 1 : 0; }

static int8_t eval_prog_next() {
    int8_t err = BERROR_NONE;
    prog_t *pc = bmem->bstate.pc;

    if (pc) {
        err = eval_prog(pc, true);
        if (err == BERROR_NONE) {
            if (bmem->bstate.pc == pc && bmem->bstate.in_goto == 0) {
                // If executed line did not change PC then move PC to next line
                bmem->bstate.pc = bmem_prog_next_line(bmem->bstate.pc);
            }
            return BERROR_NONE;
        }
    }

    if (err != BERROR_NONE && bmem->bstate.pc != 0) {
        char buffer[32];
        snprintf(buffer, sizeof(buffer), "On line %d: Error %d\r\n",
                 bmem->bstate.pc->line_no, (int)-err);
        os_redir_print_string(buffer);
    }

    bmem->bstate.pc = 0;
    bmem->bstate.running = 0;

    return err;
}

static inline bool eval_running() { return bmem->bstate.running; }

static void eval_stop() {
    bmem->bstate.running = 0;
    eval_input_mode(false);
}

static void eval_cont() { bmem->bstate.running = bmem->bstate.pc != 0; }

static void eval_reset() { bmem->bstate.reset = 1; }

static void eval_free() {
    char info[40];
    os_redir_print_string("       sys  prog  vars    db       free\r\n");

    snprintf(info, sizeof(info), "obj:       %5d %5d %5d\r\n",
             bmem_line_count(), bmem_var_count(), bdb_entry_count());
    os_redir_print_string(info);

    // The info string is max 39 chars length
    snprintf(info, sizeof(info), "mem: %5d %5d %5d %5d %5d+%4d",
             (int)(bmem->prog_start - (uint8_t *)bmem),
             (int)(bmem->prog_end - bmem->prog_start),
             (int)(bmem->vars_end - bmem->vars_start),
             (int)(bmem->db_end - bmem->db_start),
             (int)(bmem->vars_start - bmem->strings_end),
             (int)(BASTOS_DB_SIZE - (bmem->db_end - bmem->db_start)));
    os_redir_print_string(info);

    os_redir_print_string("\r\n\r\n");
}

static void eval_bastos() {
    os_redir_print_string(MODE_INIT_STRING LINE0 CLEOL CLS " BASTOS ");
    os_redir_print_integer("%dK", BASTOS_MEMORY_SIZE_KB);
    os_redir_print_string(" Microcontroller (v1)\r\n Basic for Terminal "
                          "Operating System\r\n on ");
    hal_print_oem_string();
    char info[64];
    snprintf(info, sizeof(info),
             "\r\n\r\n (c) 2024-2025 ABa\r\n\r\n %d+%d bytes free\r\n\r\n" CON,
             (int)(bmem->vars_start - bmem->strings_end),
             (int)(BASTOS_DB_SIZE - (bmem->db_end - bmem->db_start)));
    os_redir_print_string(info);
    bmem_screen_clear();

    if (!eval_running()) {
        hal_print_string("Ready\r\n");
    }
}

static bool eval_inputting() { return bmem->bstate.inputting; }

static bool eval_run() {
    if (!eval_token(TOKEN_KEYWORD_RUN))
        return false;

    // Default line is first one
    bmem->bstate.number = 0;

    // Check args
    bool arg1 = eval_expr(TOKEN_NUMBER | TOKEN_STRING);
    bool arg1_is_string = arg1 && bmem->bstate.token == TOKEN_STRING;
    bool arg2 = false;
    if (arg1_is_string && eval_token(',')) {
        arg2 = eval_expr(TOKEN_NUMBER);
        if (!arg2)
            return false;
    }

    if (!bmem->bstate.do_eval)
        return true;

    bool var_clear = true;
    int32_t line_no = (int32_t)bmem->bstate.number;
    if (line_no < 0) {
        bmem->bstate.error = BERROR_RANGE;
        return true;
    }

    if (arg1_is_string) {
        eval_load();
        if (bmem->bstate.error != BERROR_NONE)
            return true;
        var_clear = false;
    }

    running_state_clear();
    if (var_clear) bmem_vars_clear();
    eval_goto(line_no);

    return true;
}

static void eval_goto(uint16_t line_no) {
    bmem->bstate.pc = bmem_prog_get_line_or_next(line_no);
    bmem->bstate.running = bmem->bstate.pc != 0;

    if (bmem->bstate.running) {
        bmem->bstate.in_goto = 1;
    }
}

static void eval_gosub() {
    if (bmem->bstate.sp >= EVAL_RETURNS_SIZE) {
        bmem->bstate.error = BERROR_RUN;
        return;
    }

    // Resume right after this GOSUB on its own line (possibly followed by
    // more ':'-separated statements), not necessarily at the next line.
    // Skip the ':' itself so the resumed line starts exactly where the
    // outer statement loop expects: at the beginning of a statement.
    uint8_t *resume_ptr = bmem->bstate.read_ptr;
    if (*resume_ptr == ':')
        resume_ptr++;
    uint16_t return_line_no = bmem->bstate.prog->line_no;
    uint16_t return_offset = (uint16_t)(resume_ptr - bmem->bstate.prog->line);

    bmem->bstate.pc = bmem_prog_get_line_or_next(bmem->bstate.number);
    bmem->bstate.running = bmem->bstate.pc != 0;

    if (!bmem->bstate.pc) {
        bmem->bstate.error = BERROR_RUN;
        return;
    }

    bmem->returns[bmem->bstate.sp].line_no = return_line_no;
    bmem->returns[bmem->bstate.sp].offset = return_offset;
    bmem->bstate.sp++;
}

static void eval_return() {
    if (bmem->bstate.sp < 1) {
        bmem->bstate.error = BERROR_RUN;
        return;
    }

    return_t ret = bmem->returns[--bmem->bstate.sp];
    bmem->bstate.pc = bmem_prog_get_line_or_next(ret.line_no);
    bmem->bstate.running = bmem->bstate.pc != 0;
    bmem->bstate.pc_offset = bmem->bstate.pc ? ret.offset : 0;
}

static bool eval_save() {
    if (string_len(bmem->bstate.string) == 0)
        return false;

    if (bastos_save(string_cstr(bmem->bstate.string)) < 0) {
        bmem->bstate.error = BERROR_IO;
        return false;
    }

    return true;
}

static void eval_load() {
    if (bmem->bstate.string == 0)
        return;

    bmem->bstate.error = bastos_load(string_cstr(bmem->bstate.string));
}

static void eval_erase() {
    if (hal_erase(string_cstr(bmem->bstate.string)) != 0) {
        bmem->bstate.error = BERROR_IO;
    }
}

static void eval_clear() {
    running_state_clear();
    bmem_vars_clear();
}

static void eval_new() {
    running_state_clear();
    bastos_prog_new();
}

static bool eval_paused() { return bmem->pause_delay != 0; }

static void eval_check_pause() {
    if (hal_get_ms() - bmem->pause_start_time >= bmem->pause_delay) {
        bmem->pause_delay = 0;
    }
}

static void eval_pause() {
    bmem->pause_delay = bmem->bstate.number;
    bmem->pause_start_time = hal_get_ms();
}

static bool eval_string_tty() {
    uint8_t *back_ptr = eval_store_read_ptr();

    if (!eval_token_one_of(tty_codes))
        return false;

    uint8_t fn = bmem->bstate.token;
    char codes[CODE_SEQUENCE_MAX_SIZE];
    *codes = 0;

    // 0 arg
    if (fn == TOKEN_KEYWORD_CLS) {
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, bmem->bstate.screen_mode ? MODE80_CLS : CLS);
        bmem_screen_clear();
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_CLEOL) {
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, bmem->bstate.screen_mode ? MODE80_CLEOL : CLEOL);
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_BEEP) {
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x07");
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_LINE0) {
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1f\x40\x41");
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_G0) {
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, G0);
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_G1) {
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, G1);
        goto EVAL;
    }

    // special args
    if (fn == TOKEN_KEYWORD_SCROLL) {
        if (eval_token(TOKEN_KEYWORD_UP)) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, CUR "\n", 24 + CUR_DELTA_V, 1 + CUR_DELTA_H);
            goto EVAL;
        }
        if (eval_token(TOKEN_KEYWORD_DOWN)) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1e\x0b");
            goto EVAL;
        }
    }

    if (fn == TOKEN_KEYWORD_DEL) {
        if (eval_token(TOKEN_KEYWORD_LINE)) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1b\x5b\x4d");
            goto EVAL;
        }
        if (eval_token(TOKEN_KEYWORD_CHAR)) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1b\x5b\x50");
            goto EVAL;
        }
        // TODO: eval DEL CHAR
        return false;
    }

    if (fn == TOKEN_KEYWORD_INS) {
        if (eval_token(TOKEN_KEYWORD_LINE)) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1b\x5b\x4c");
            goto EVAL;
        }
        // TODO: eval DEL CHAR
        return false;
    }

    if (!eval_float_expr()) {
        if (fn == TOKEN_KEYWORD_SCROLL) {
            // 0 arg scroll
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, CUR "\n", 24 + CUR_DELTA_V, 1 + CUR_DELTA_H);
            goto EVAL;
        }
        eval_restore_read_ptr(back_ptr);
        return false;
    }

    // 1 arg
    int8_t arg1 = bmem->bstate.number;
    if (fn == TOKEN_KEYWORD_INK) {
        bmem->ink = arg1;
        if (bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "%s", arg1 == 7 ? MODE80_BOLD : MODE80_BOLD_OFF);
        } else {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, INK, arg1 + INK_DELTA);
        }
        goto EVAL;
    }
    if (fn == TOKEN_KEYWORD_PAPER) {
        bmem->paper = arg1;
        if (!bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, PAPER, arg1 + PAPER_DELTA);
        }
        goto EVAL;
    }
    if (fn == TOKEN_KEYWORD_CURSOR) {
        if (bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "%s", arg1 ? MODE80_CON : MODE80_COFF);
        } else {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "%s", arg1 ? CON : COFF);
        }
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_FLASH) {
        if (bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? MODE80_BLINK : MODE80_BLINK_OFF);
        } else {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? "\x1b\x48" : "\x1b\x49");
        }
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_INVERSE) {
        if (bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? MODE80_INV : MODE80_INV_OFF);
        } else {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? "\x1b\x5d" : "\x1b\x5c");
        }
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_UNDERLINE) {
        if (bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? MODE80_UNDERLINE : MODE80_UNDERLINE_OFF);
        } else {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? "\x1b\x5a" : "\x1b\x59");
        }
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_ECHO) {
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? P_LOCAL_ECHO_ON : P_LOCAL_ECHO_OFF);
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_SIZE) {
        if (arg1 > 3) {
            bmem->bstate.error = BERROR_RANGE;
            return false;
        }
        snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1b%c", arg1 + '\x4c');
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_SCROLL) {
        if (bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? MODE80_ROULEAU_ON : MODE80_ROULEAU_OFF);
        } else {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, arg1 ? P_ROULEAU_ON : P_ROULEAU_OFF);
        }
        goto EVAL;
    }

    if (fn == TOKEN_KEYWORD_MODE) {
        bool was_mode80 = bmem->bstate.screen_mode != 0;
        bmem->bstate.screen_mode = (arg1 >= 2) ? 1 : 0;
        if (bmem->bstate.screen_mode) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "%s", P_80_COLS);
        } else if (was_mode80) {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "%s%s%s%s", P_40_COLS,
                     P_CLAVIER_MINUSCULE, P_CLAVIER_ETENDU, CON);
        } else {
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "%s", P_40_COLS);
        }
        goto EVAL;
    }

    // 2 args
    if (!eval_token(',')) {
        eval_restore_read_ptr(back_ptr);
        return false;
    }

    if (!eval_float_expr()) {
        eval_restore_read_ptr(back_ptr);
        return false;
    }

    int8_t arg2 = bmem->bstate.number;

    if (fn == TOKEN_KEYWORD_ORIGIN) {
        if (bmem->bstate.do_eval) {
            bmem->ofs_l = arg1;
            bmem->ofs_c = arg2;
        }
        return true;
    } else if (fn == TOKEN_KEYWORD_PLOT || fn == TOKEN_KEYWORD_UNPLOT) {
        if (!bmem->bstate.do_eval)
            return true;
        eval_graphic_fn(fn, arg1, arg2, codes);
    } else {
        // fn = TOKEN_KEYWORD_AT
        arg1 += bmem->ofs_l;
        arg2 += bmem->ofs_c;
        if (bmem->bstate.screen_mode) {
            // Mode 80 colonnes: utiliser les codes ANSI
            snprintf(codes, CODE_SEQUENCE_MAX_SIZE, MODE80_CUR, arg1 + MODE80_CUR_DELTA_V,
                    arg2 + MODE80_CUR_DELTA_H);
        } else {
            // Mode 40 colonnes (Minitel)
            if (arg1 == 1 && arg2 == 1) {
                snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1e");
            } else if (arg1 == 1 && arg2 == 2) {
                snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1e\x09");
            } else if (arg1 == 2 && arg2 == 1) {
                snprintf(codes, CODE_SEQUENCE_MAX_SIZE, "\x1e\n");
            } else {
                snprintf(codes, CODE_SEQUENCE_MAX_SIZE, CUR, arg1 + CUR_DELTA_V,
                        arg2 + CUR_DELTA_H);
            }
        }
    }

EVAL:
    if (!bmem->bstate.do_eval)
        return true;

    uint8_t len = strlen(codes);
    bmem->bstate.string = bmem_string_alloc(len);
    if (!bmem->bstate.string) {
        eval_restore_read_ptr(back_ptr);
        return false;
    }

    // Copy codes to string
    for (uint8_t i = 0; i <= len; i++) {
        bmem->bstate.string[i + 2] = codes[i];
    }

    return true;
}

static bool eval_simple_instruction() {
    uint8_t instr;

    // 0 arg instructions
    if ((instr = eval_token_one_of((char *)instr0)))
        goto EVAL;

    // 1 string instructions
    if ((instr = eval_token_one_of((char *)instr1s)) && eval_string_expr())
        goto EVAL;

    // 1 number instructions
    if ((instr = eval_token_one_of((char *)instr1n)) && eval_expr(TOKEN_NUMBER))
        goto EVAL;

    if (eval_token_one_of(tty_codes))
        return eval_print(true);

    return false;

EVAL:
    if (!bmem->bstate.do_eval)
        return true;

    if (instr == TOKEN_KEYWORD_DEBUG) {
        bmem->bstate.debug = bmem->bstate.number != 0.0;
        return true;
    }
    if (instr == TOKEN_KEYWORD_GOTO) {
        eval_goto(bmem->bstate.number);
        return true;
    }
    if (instr == TOKEN_KEYWORD_GOSUB) {
        eval_gosub();
        return true;
    }
    if (instr == TOKEN_KEYWORD_PAUSE) {
        eval_pause();
        return true;
    }
    if (instr == TOKEN_KEYWORD_ERASE) {
        eval_erase();
        return true;
    }
    if (instr == TOKEN_KEYWORD_SAVE) {
        return eval_save();
    }
    if (instr == TOKEN_KEYWORD_LOAD) {
        eval_load();
        return true;
    }
    if (instr == TOKEN_KEYWORD_RETURN) {
        eval_return();
        return true;
    }
    if (instr == TOKEN_KEYWORD_CLEAR || instr == TOKEN_KEYWORD_END) {
        eval_clear();
        return true;
    }
    if (instr == TOKEN_KEYWORD_NEW) {
        eval_new();
        return true;
    }
    if (instr == TOKEN_KEYWORD_RESET) {
        eval_reset();
        return true;
    }
    if (instr == TOKEN_KEYWORD_CAT) {
        os_cat();
        return true;
    }
    if (instr == TOKEN_KEYWORD_FAST2 || instr == TOKEN_KEYWORD_FAST || instr == TOKEN_KEYWORD_SLOW) {
        hal_speed(instr);
        return true;
    }
    if (instr == TOKEN_KEYWORD_STOP) {
        eval_stop();
        return true;
    }
    if (instr == TOKEN_KEYWORD_CONT) {
        eval_cont();
        return true;
    }
    if (instr == TOKEN_KEYWORD_FREE) {
        eval_free();
        return true;
    }
    if (instr == TOKEN_KEYWORD_BASTOS) {
        eval_bastos();
        return true;
    }
    return false;
}

static bool eval_rem() {
    if (!eval_token(TOKEN_KEYWORD_REM))
        return false;

    if (!eval_string_const())
        return false;

    return true;
}

static bool eval_wifi_scan(void) {
    if (!bmem->bstate.do_eval)
        return true;

    os_wifi_scan();
    return true;
}

static char *eval_get_ssid() {
    if (bmem->bstate.token == TOKEN_NUMBER) {
        return bmem_ssid_get_from_id(bmem->bstate.number);
    } else {
        return string_cstr(bmem->bstate.string);
    }
}

static bool eval_wifi_connect(void) {
    if (!eval_expr(TOKEN_STRING | TOKEN_NUMBER))
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    char *ssid = eval_get_ssid();
    if (ssid == 0 || string_len(ssid) == 0) {
        bmem->bstate.error = BERROR_WIFI;
        return true;
    }

    int ret = os_wifi_connect(ssid);
    if (ret < 0) {
        bmem->bstate.error = BERROR_WIFI;
        return true;
    }

    return true;
}

static bool eval_wifi_erase(void) {
    if (!eval_expr(TOKEN_STRING | TOKEN_NUMBER))
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    char *ssid = eval_get_ssid();
    if (ssid == 0 || string_len(ssid) == 0) {
        bmem->bstate.error = BERROR_WIFI;
        return true;
    }

    int ret = os_wifi_erase(ssid);
    if (ret < 0) {
        bmem->bstate.error = BERROR_WIFI;
        return true;
    }

    return true;
}

static bool eval_wifi_disconnect(void) {
    if (!bmem->bstate.do_eval)
        return true;

    hal_wifi_disconnect();
    return true;
}

static bool eval_wifi_status(void) {
    if (!bmem->bstate.do_eval)
        return true;

    os_wifi_status();
    return true;
}

static bool eval_db_list(uint8_t set) {
    if (!bmem->bstate.do_eval)
        return true;

    os_db_list(set);
    return true;
}

static bool eval_wifi() {
    if (!eval_token(TOKEN_KEYWORD_WIFI))
        return false;

    uint8_t func = eval_token_one_of((char *)wifi_func);
    if (func == 0 || func == TOKEN_KEYWORD_START)
        return eval_wifi_connect();

    if (func == TOKEN_KEYWORD_SCAN)
        return eval_wifi_scan();

    if (func == TOKEN_KEYWORD_LIST)
        return eval_db_list(DB_WIFI_SET);

    if (func == TOKEN_KEYWORD_ERASE)
        return eval_wifi_erase();

    if (func == TOKEN_KEYWORD_STATUS)
        return eval_wifi_status();

    if (func == TOKEN_KEYWORD_STOP)
        return eval_wifi_disconnect();

    return false;
}

static bool eval_connect(uint8_t set) {
    char *name = 0;
    char *urn = 0;
    int n = 1;

    if (!eval_string_expr())
        return false;

    if (eval_token(',')) {
        if (bmem->bstate.do_eval) {
            name = string_dup(bmem->bstate.string);
        }

        if (!eval_string_expr())
            return false;

        n++;
    }

    if (!bmem->bstate.do_eval)
        return true;

    char *param = bmem->bstate.string;
    if (n == 1 && !bdb_is_urn(param)) {
        name = string_dup(param);
    } else {
        urn = param;
    }

    int fd = os_connect(set, string_cstr(name), string_cstr(urn));
    if (fd < 0) {
        bmem->bstate.error = BERROR_SOCK;
    }

    if (set == DB_MIN_SET) {
        bmem->sock = fd;
    }

    return true;
}

static bool eval_db_erase(uint8_t set) {
    if (!eval_expr(TOKEN_STRING))
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    os_db_erase(set, string_cstr(bmem->bstate.string));
    return true;
}

static bool eval_db() {
    if (!eval_token(TOKEN_KEYWORD_DB))
        return false;

    uint8_t func = eval_token_one_of((char *)db_func);
    if (func == 0)
        return false;

    if (!eval_expr(TOKEN_NUMBER))
        return false;

    uint8_t set = (uint8_t)bmem->bstate.number;

    if (func == TOKEN_KEYWORD_LIST)
        return eval_db_list(set);

    if (func == TOKEN_KEYWORD_ERASE) {
        if (!eval_token(','))
            return false;

        return eval_db_erase(set);
    }

    return false;
}

static bool eval_minitel() {
    if (!eval_token(TOKEN_KEYWORD_MINITEL))
        return false;

    uint8_t func = eval_token_one_of((char *)minitel_func);
    if (func == 0 || func == TOKEN_KEYWORD_START) {
        hal_print_string(P_ROULEAU_OFF);
        return eval_connect(DB_MIN_SET);
    }

    if (func == TOKEN_KEYWORD_LIST)
        return eval_db_list(DB_MIN_SET);

    if (func == TOKEN_KEYWORD_ERASE)
        return eval_db_erase(DB_MIN_SET);

    return false;
}

static bool eval_disconnect(uint8_t set) {
    if (bmem->bstate.do_eval)
        os_disconnect(set);

    return true;
}

static bool eval_ftp_file(uint8_t func) {
    if (!eval_string_expr())
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    if (!os_ftp_files(func, string_cstr(bmem->bstate.string))) {
        bmem->bstate.error = BERROR_SOCK;
        return true;
    }

    if (!eval_running()) {
        hal_print_string("OK\r\n");
    }

    return true;
}

static bool eval_ftp() {
    if (!eval_token(TOKEN_KEYWORD_FTP))
        return false;

    uint8_t func = eval_token_one_of((char *)ftp_func);
    if (func == 0 || func == TOKEN_KEYWORD_START)
        return eval_connect(DB_FTP_SET);

    if (func == TOKEN_KEYWORD_ERASE)
        return eval_db_erase(DB_FTP_SET);

    if (func == TOKEN_KEYWORD_PUT)
        return eval_ftp_file(TOKEN_KEYWORD_PUT);

    if (func == TOKEN_KEYWORD_GET)
        return eval_ftp_file(TOKEN_KEYWORD_GET);

    if (func == TOKEN_KEYWORD_LIST)
        return eval_db_list(DB_FTP_SET);

    if (func == TOKEN_KEYWORD_STOP)
        return eval_disconnect(DB_FTP_SET);

    if (!bmem->bstate.do_eval)
        return true;

    if (func == TOKEN_KEYWORD_STATUS)
        os_ftp_status();

    if (func == TOKEN_KEYWORD_CAT)
        os_ftp_cat();

    return true;
}

static bool eval_instruction() {
    return eval_print(false) || eval_input() || eval_simple_instruction() ||
           eval_run() || eval_rem() || eval_dim() || eval_list() ||
           eval_edit() || eval_put() || eval_db() || eval_wifi() ||
           eval_minitel() || eval_ftp() || eval_output() || eval_let();
}

static bool eval_if() {
    if (!eval_token(TOKEN_KEYWORD_IF))
        return false;

    if (!eval_expr(TOKEN_NUMBER))
        return false;

    if (bmem->bstate.do_eval) {
        if (bmem->bstate.number == 0) {
            // If test is negative, ignore end of line
            bmem->bstate.read_ptr =
                bmem->bstate.prog->line + bmem->bstate.prog->len;
            return true;
        }
    }

    if (!eval_token(TOKEN_KEYWORD_THEN))
        return false;

    if (eval_expr(TOKEN_NUMBER)) {
        if (bmem->bstate.do_eval)
            eval_goto(bmem->bstate.number);
        return true;
    }

    if (!eval_instruction())
        return false;

    return true;
}

static bool eval_for() {
    if (!eval_token(TOKEN_KEYWORD_FOR))
        return false;

    if (!eval_variable_ref() ||
        bmem->bstate.var_ref[0] != TOKEN_VARIABLE_NUMBER ||
        bmem->bstate.var_ref[2] != 0)
        return false;

    if (!eval_token('='))
        return false;

    if (!eval_expr(TOKEN_NUMBER))
        return false;

    float init = bmem->bstate.number;

    if (!eval_token(TOKEN_KEYWORD_TO))
        return false;

    if (!eval_expr(TOKEN_NUMBER))
        return false;

    float limit = bmem->bstate.number;
    float step = 1;

    if (eval_token(TOKEN_KEYWORD_STEP)) {
        if (!eval_expr(TOKEN_NUMBER))
            return false;

        step = bmem->bstate.number;
    }

    if (!bmem->bstate.do_eval)
        return true;

    int loop_index = bmem->bstate.var_ref[1] - 'A';
    if (loop_index < 0 || loop_index > 25) {
        bmem->bstate.error = BERROR_RANGE;
        return true;
    }

    loop_t *loop = bmem->loops + loop_index;
    if (loop->for_line != 0)
        return true;

    if (bmem_var_number_set(bmem->bstate.var_ref, init) == 0) {
        bmem->bstate.error = BERROR_MEMORY;
        return true;
    }

    loop->for_line = bmem->bstate.prog;
    loop->limit = limit;
    loop->step = step;
    // TODO: Search for next and run next? Check in emulator

    // Track nesting order so a variable-less NEXT can target the innermost
    // active loop.
    if (bmem->bstate.for_sp < sizeof(bmem->for_stack))
        bmem->for_stack[bmem->bstate.for_sp++] = (uint8_t)loop_index;

    return true;
}

static bool eval_next() {
    if (!eval_token(TOKEN_KEYWORD_NEXT))
        return false;

    // The loop variable is optional: NEXT (with or without one) always
    // closes the innermost currently active FOR loop, like a stack — a
    // named variable is only a consistency check on which loop that is.
    bool has_var = eval_variable_ref();
    if (has_var && *bmem->bstate.var_ref != TOKEN_VARIABLE_NUMBER)
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    if (bmem->bstate.for_sp == 0) {
        bmem->bstate.error = BERROR_RUN;
        return true;
    }

    int loop_index = bmem->for_stack[bmem->bstate.for_sp - 1];

    char synth_ref[3];
    if (has_var) {
        int named_index = bmem->bstate.var_ref[1] - 'A';
        if (named_index < 0 || named_index > 25) {
            bmem->bstate.error = BERROR_RANGE;
            return true;
        }
        if (named_index != loop_index) {
            // NEXT must close the innermost active loop; naming any other
            // one is a mismatch.
            bmem->bstate.error = BERROR_RUN;
            return true;
        }
    } else {
        // Synthesize a var_ref for the innermost loop's own variable, in
        // the same [marker][letter][0] shape eval_variable_ref() produces.
        synth_ref[0] = TOKEN_VARIABLE_NUMBER;
        synth_ref[1] = (char)('A' + loop_index);
        synth_ref[2] = 0;
        bmem->bstate.var_ref = synth_ref;
    }

    loop_t *loop = bmem->loops + loop_index;

    var_t *var = bmem_var_get(bmem->bstate.var_ref);
    if (var == 0) {
        bmem->bstate.error = BERROR_RUN;
        return true;
    }

    var->numbers[0] += loop->step;
    float cmp = loop->step >= 0 ? loop->limit - var->numbers[0]
                                : var->numbers[0] - loop->limit;
    if (cmp >= 0) {
        // Jump back to the FOR line (which may be this same line when the
        // whole loop lives on one ':'-separated line): mark it explicitly
        // so the caller does not mistake it for a straight fall-through.
        bmem->bstate.pc = loop->for_line;
        bmem->bstate.in_goto = 1;
    } else {
        // Loop done: leave pc untouched so execution falls through to any
        // remaining ':'-separated statements on this line, then the normal
        // next-line advance takes over.
        loop->for_line = 0;
        bmem->bstate.for_sp--;
    }

    return true;
}

// EDIT <line_no>: validates the target line exists and remembers it in
// bmem->io_edit_line. Once bastos_input() has removed this EDIT command
// itself from io_buffer, it loads that line's own text into io_buffer,
// shows it, and places the cursor at its end — ready to be edited with the
// arrow keys/Correction instead of retyped from scratch. Deferred this way
// because io_buffer still holds the EDIT command itself while this runs;
// overwriting it now would corrupt bastos_input()'s own bookkeeping.
static bool eval_edit() {
    if (!eval_token(TOKEN_KEYWORD_EDIT))
        return false;

    if (!eval_expr(TOKEN_NUMBER))
        return false;

    if (!bmem->bstate.do_eval)
        return true;

    int32_t line_no = (int32_t)bmem->bstate.number;
    if (line_no < 1 || line_no > 65535) {
        bmem->bstate.error = BERROR_RANGE;
        return true;
    }

    prog_t *prog = bmem_prog_get_line_or_next((uint16_t)line_no);
    if (!prog || prog->line_no != (uint16_t)line_no) {
        bmem->bstate.error = BERROR_RUN;
        return true;
    }

    bmem->io_edit_line = (uint16_t)line_no;
    return true;
}

static int8_t eval_prog(prog_t *prog, bool do_eval) {
    // Init evaluator state
    bmem->bstate.do_eval = do_eval ? 1 : 0;
    // pc_offset only makes sense to resume a RUN right after a GOSUB (set by
    // eval_return()); a plain syntax check of a freshly typed line always
    // starts at its beginning.
    bmem->bstate.read_ptr = prog->line + (do_eval ? bmem->bstate.pc_offset : 0);
    bmem->bstate.pc_offset = 0;
    bmem->bstate.token = 0;
    bmem->bstate.string = 0;
    bmem->bstate.error = BERROR_NONE;
    bmem->bstate.prog = prog;
    bmem->bstate.in_goto = 0;

    // Do syntax check or eval, one statement at a time, separated by ':'.
    // pc is only meaningful as a "did we jump away" signal while actually
    // running: statements never touch it during a syntax check.
    prog_t *entry_pc = bmem->bstate.pc;
    bool eval = true;
    bool jumped = false;
    while (bmem->bstate.read_ptr && *bmem->bstate.read_ptr != 0 &&
           *bmem->bstate.read_ptr != '\'') {
        eval = eval_instruction() || eval_if() || eval_for() || eval_next();
        if (!eval || bmem->bstate.error != BERROR_NONE)
            break;

        // LOAD replaces the whole program in memory and resets read_ptr to
        // NULL since this line's own storage may no longer be valid:
        // nothing more can be read from it.
        if (!bmem->bstate.read_ptr)
            break;

        // A jump (GOTO/GOSUB/RETURN/RUN/NEXT) leaves this line: whatever
        // follows on this line must not run now (it stays for a later
        // resume, e.g. after a GOSUB's matching RETURN).
        if (bmem->bstate.pc != entry_pc || bmem->bstate.in_goto) {
            jumped = true;
            break;
        }

        if (!eval_token(':'))
            break;
    }

    // Syntax check end of line (skipped when we deliberately jumped away
    // mid-line: the remaining ':'-statements are left for a later resume).
    // A trailing comment is a valid end of line too: it is kept for LIST
    // but never interpreted.
    if (!jumped) {
        eval = eval && (bmem->bstate.read_ptr == 0 ||
                         *bmem->bstate.read_ptr == 0 ||
                         *bmem->bstate.read_ptr == '\'');
    }

    // Free evaluator state
    bmem->bstate.string = 0;
    bmem_strings_clear();

    // Handle syntax error
    if (!eval && bmem->bstate.error == BERROR_NONE) {
        bmem->bstate.error = BERROR_SYNTAX;
    }

    return bmem->bstate.error;
}
