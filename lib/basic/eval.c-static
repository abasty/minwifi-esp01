extern bmem_t *bmem;

static inline uint8_t* eval_store_read_ptr()
{
    return bmem->bstate.read_ptr;
}

static inline void eval_restore_read_ptr(uint8_t *back_ptr)
{
    bmem->bstate.read_ptr = back_ptr;
}

